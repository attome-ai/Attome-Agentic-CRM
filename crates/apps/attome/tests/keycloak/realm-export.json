{
  "realm": "attome-test",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "groups": [
    {
      "name": "sales"
    }
  ],
  "users": [
    {
      "username": "attome-test-user",
      "email": "attome-test-user@attome-test.invalid",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Attome",
      "lastName": "Test",
      "credentials": [
        {
          "type": "password",
          "value": "attome-test-Passw0rd!",
          "temporary": false
        }
      ]
    },
    {
      "username": "attome-sales-user",
      "email": "attome-sales-user@attome-test.invalid",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sales",
      "lastName": "Test",
      "groups": [
        "/sales"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "attome-sales-Passw0rd!",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "attome-oidc-test",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "oidc-test-client-secret-throwaway",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://localhost:9999/api/v1/auth/oidc/keycloak/callback",
        "http://localhost:9999/api/v1/auth/oidc/keycloak-db/callback"
      ],
      "attributes": {
        "backchannel.logout.url": "http://host.docker.internal:9998/api/v1/auth/oidc/keycloak-db/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "openid",
        "email",
        "profile"
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "saml-idp",
      "displayName": "SAML IdP (test)",
      "providerId": "saml",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "entityId": "attome-test-broker",
        "idpEntityId": "http://localhost:8090/realms/saml-idp",
        "singleSignOnServiceUrl": "http://localhost:8090/realms/saml-idp/protocol/saml",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress",
        "principalType": "SUBJECT",
        "postBindingAuthnRequest": "false",
        "postBindingResponse": "false",
        "postBindingLogout": "false",
        "wantAuthnRequestsSigned": "false",
        "wantAssertionsSigned": "false",
        "wantAssertionsEncrypted": "false",
        "validateSignature": "false",
        "forceAuthn": "false",
        "syncMode": "IMPORT"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "email",
      "identityProviderAlias": "saml-idp",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "firstName",
      "identityProviderAlias": "saml-idp",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "firstName",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "lastName",
      "identityProviderAlias": "saml-idp",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute.name": "lastName",
        "user.attribute": "lastName"
      }
    },
    {
      "name": "sales-group",
      "identityProviderAlias": "saml-idp",
      "identityProviderMapper": "saml-advanced-group-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "attributes": "[{\"key\":\"groups\",\"value\":\"sales\"}]",
        "are.attribute.values.regex": "false",
        "group": "/sales"
      }
    }
  ]
}
