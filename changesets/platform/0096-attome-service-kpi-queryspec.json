                  "op": "is_not_null"
                },
                {
                  "field": "resolved_at",
                  "kind": "compare",
                  "op": "last_n_days",
                  "value": 30
                }
              ],
              "kind": "and"
            }
          },
          "required_privilege": "service_ticket.read",
          "sql": "",
          "table_definition": "[]"
        }
