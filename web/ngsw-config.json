{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/main-*.js",
          "/polyfills-*.js",
          "/styles-*.css"
        ]
      }
    },
    {
      "name": "lazy-code",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/chunk-*.js",
          "/worker-*.js",
          "/*.css"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/media/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "render-plans",
      "urls": ["/api/v1/cooked/*/*"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 500,
        "maxAge": "1d"
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/api/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**"
  ]
}
