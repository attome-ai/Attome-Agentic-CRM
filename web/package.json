{
  "name": "attome-website",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "generate:api": "node scripts/generate-api-types.mjs",
    "generate:icons": "node scripts/line-awesome-subset.mjs",
    "check:chunks": "node scripts/chunk-budget.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:colours": "node scripts/check-colours.mjs",
    "check:logical-css": "node scripts/check-logical-css.mjs",
    "build:base": "ng build base",
    "build:xrm": "ng build xrm",
    "build:sdk": "ng build sdk",
    "build:component-sdk": "ng build component-sdk",
    "build:all": "npm run build:base && npm run build:xrm && npm run build:sdk && npm run build",
    "lint:base": "ng lint base",
    "lint:xrm": "ng lint xrm",
    "lint:sdk": "ng lint sdk",
    "test:base": "ng test base --watch=false",
    "test:xrm": "ng test xrm --watch=false",
    "test:sdk": "ng test sdk --watch=false",
    "test:component-sdk": "ng test component-sdk --watch=false",
    "test:embed": "node --test scripts/webchat-embed.test.mjs scripts/cobrowse-embed.test.mjs scripts/consent-banner.test.mjs",
    "start": "ng serve --port 4199 --host 127.0.0.1 --poll 500",
    "start:prod": "ng serve --configuration production --port 4199 --poll 500",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "lint": "ng lint",
    "test": "ng test attome-website --watch=false",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "audit:dev": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/service-worker": "^22.2.2",
    "@attome/base": "file:dist/base",
    "@attome/xrm": "file:dist/xrm",
    "@fontsource/cairo": "^5.0.0",
    "@fontsource/dm-sans": "^5.0.0",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/playfair-display": "^5.0.0",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-messageformat": "^8.4.0",
    "bwip-js": "4.11.4",
    "country-flag-emoji-polyfill": "^0.1.10",
    "line-awesome": "1.3.0",
    "maplibre-gl": "6.14.0",
    "minisearch": "7.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zxing-wasm": "3.1.5"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^27.4.0",
    "ng-packagr": "^22.0.0",
    "openapi-typescript": "^7.13.0",
    "subset-font": "^2.5.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "brace-expansion": "^5.0.12",
    "vite": "8.3.4",
    "zod": "^4.6.6",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
