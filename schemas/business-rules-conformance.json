{
  "$comment": "Business-rule condition conformance fixture (D-789 rule 2, BUSINESS-RULES-DESIGN.md section 2). The server evaluates each condition through attome_core::business_rules::compile_condition + attome-rules (include_str! in that module's tests); the client evaluates it with evaluateBusinessRuleCondition in a vitest spec. Both must produce `expected`. Structured leaves only: advanced (expression) leaves are server-only. Semantics: text comparisons are case-insensitive after trimming; choice keys compare exactly; a leaf on an empty field is false except is_empty, ne and not_in; empty means null/absent, a blank string, or an empty list; a value of the wrong JSON type counts as empty; a date value is RFC 3339 or YYYY-MM-DD (midnight UTC).",
  "version": 1,
  "fields": [
    { "name": "title", "type": "text" },
    { "name": "amount", "type": "number" },
    { "name": "price", "type": "currency" },
    { "name": "due", "type": "date" },
    { "name": "is_vip", "type": "bool" },
    { "name": "status", "type": "choice", "choices": ["open", "pending", "closed"] },
    { "name": "tags", "type": "choice", "multi": true, "choices": ["a", "b", "c"] },
    { "name": "account", "type": "lookup" },
    { "name": "total", "type": "formula", "result_type": "number" }
  ],
  "cases": [
    { "name": "root all [] is always true", "condition": { "all": [] }, "record": {}, "expected": true },

    { "name": "text eq ignores case and surrounding blanks", "condition": { "field": "title", "op": "eq", "value": "Hello" }, "record": { "title": "  hello " }, "expected": true },
    { "name": "text eq mismatch", "condition": { "field": "title", "op": "eq", "value": "Hello" }, "record": { "title": "world" }, "expected": false },
    { "name": "text eq on empty field is false", "condition": { "field": "title", "op": "eq", "value": "Hello" }, "record": {}, "expected": false },
    { "name": "text ne on empty field is true", "condition": { "field": "title", "op": "ne", "value": "Hello" }, "record": { "title": null }, "expected": true },
    { "name": "text ne on equal value is false", "condition": { "field": "title", "op": "ne", "value": "hello" }, "record": { "title": "HELLO" }, "expected": false },
    { "name": "text in matches any", "condition": { "field": "title", "op": "in", "value": ["a", "B"] }, "record": { "title": "b" }, "expected": true },
    { "name": "text in misses", "condition": { "field": "title", "op": "in", "value": ["a", "B"] }, "record": { "title": "c" }, "expected": false },
    { "name": "text not_in on empty field is true", "condition": { "field": "title", "op": "not_in", "value": ["a"] }, "record": {}, "expected": true },
    { "name": "text not_in on a listed value is false", "condition": { "field": "title", "op": "not_in", "value": ["a"] }, "record": { "title": " A" }, "expected": false },
    { "name": "text contains ignores case", "condition": { "field": "title", "op": "contains", "value": "ELL" }, "record": { "title": "Hello world" }, "expected": true },
    { "name": "text starts_with", "condition": { "field": "title", "op": "starts_with", "value": "hel" }, "record": { "title": "Hello world" }, "expected": true },
    { "name": "text starts_with misses", "condition": { "field": "title", "op": "starts_with", "value": "wor" }, "record": { "title": "Hello world" }, "expected": false },
    { "name": "text is_empty on blanks", "condition": { "field": "title", "op": "is_empty" }, "record": { "title": "   " }, "expected": true },
    { "name": "text is_empty on absent", "condition": { "field": "title", "op": "is_empty" }, "record": {}, "expected": true },
    { "name": "text is_not_empty", "condition": { "field": "title", "op": "is_not_empty" }, "record": { "title": "x" }, "expected": true },
    { "name": "text is_not_empty on blanks", "condition": { "field": "title", "op": "is_not_empty" }, "record": { "title": " " }, "expected": false },

    { "name": "number gt", "condition": { "field": "amount", "op": "gt", "value": 100 }, "record": { "amount": 150 }, "expected": true },
    { "name": "number gt on empty field is false", "condition": { "field": "amount", "op": "gt", "value": 100 }, "record": {}, "expected": false },
    { "name": "number lte at the bound", "condition": { "field": "amount", "op": "lte", "value": 100 }, "record": { "amount": 100 }, "expected": true },
    { "name": "number lt misses", "condition": { "field": "amount", "op": "lt", "value": 100 }, "record": { "amount": 100 }, "expected": false },
    { "name": "number ne on empty field is true", "condition": { "field": "amount", "op": "ne", "value": 5 }, "record": { "amount": null }, "expected": true },
    { "name": "number eq", "condition": { "field": "amount", "op": "eq", "value": 5 }, "record": { "amount": 5.0 }, "expected": true },
    { "name": "number in", "condition": { "field": "amount", "op": "in", "value": [1, 2, 3] }, "record": { "amount": 2 }, "expected": true },
    { "name": "number not_in on empty field is true", "condition": { "field": "amount", "op": "not_in", "value": [1] }, "record": {}, "expected": true },
    { "name": "number is_empty on zero is false", "condition": { "field": "amount", "op": "is_empty" }, "record": { "amount": 0 }, "expected": false },
    { "name": "number field holding a string counts as empty", "condition": { "field": "amount", "op": "gt", "value": 1 }, "record": { "amount": "150" }, "expected": false },
    { "name": "currency gte at the bound", "condition": { "field": "price", "op": "gte", "value": 10.5 }, "record": { "price": 10.5 }, "expected": true },
    { "name": "formula field reads as its result type", "condition": { "field": "total", "op": "gt", "value": 10 }, "record": { "total": 11 }, "expected": true },

    { "name": "date lt a date-only value", "condition": { "field": "due", "op": "lt", "value": "2026-01-01" }, "record": { "due": "2025-12-31T23:59:59Z" }, "expected": true },
    { "name": "date gt is strict", "condition": { "field": "due", "op": "gt", "value": "2026-01-01T00:00:00Z" }, "record": { "due": "2026-01-01T00:00:00Z" }, "expected": false },
    { "name": "date eq across formats", "condition": { "field": "due", "op": "eq", "value": "2026-03-01" }, "record": { "due": "2026-03-01T00:00:00Z" }, "expected": true },
    { "name": "date with an offset compares as UTC", "condition": { "field": "due", "op": "eq", "value": "2026-03-01T00:00:00Z" }, "record": { "due": "2026-03-01T03:00:00+03:00" }, "expected": true },
    { "name": "date is_empty", "condition": { "field": "due", "op": "is_empty" }, "record": { "due": null }, "expected": true },

    { "name": "bool eq true", "condition": { "field": "is_vip", "op": "eq", "value": true }, "record": { "is_vip": true }, "expected": true },
    { "name": "bool eq false on empty field is false", "condition": { "field": "is_vip", "op": "eq", "value": false }, "record": {}, "expected": false },
    { "name": "bool is_not_empty on false", "condition": { "field": "is_vip", "op": "is_not_empty" }, "record": { "is_vip": false }, "expected": true },

    { "name": "choice eq", "condition": { "field": "status", "op": "eq", "value": "open" }, "record": { "status": "open" }, "expected": true },
    { "name": "choice keys compare exactly", "condition": { "field": "status", "op": "eq", "value": "open" }, "record": { "status": "Open" }, "expected": false },
    { "name": "choice ne on empty field is true", "condition": { "field": "status", "op": "ne", "value": "open" }, "record": {}, "expected": true },
    { "name": "choice in", "condition": { "field": "status", "op": "in", "value": ["open", "pending"] }, "record": { "status": "pending" }, "expected": true },
    { "name": "choice not_in", "condition": { "field": "status", "op": "not_in", "value": ["open", "pending"] }, "record": { "status": "closed" }, "expected": true },
    { "name": "choice is_empty on a blank key", "condition": { "field": "status", "op": "is_empty" }, "record": { "status": "" }, "expected": true },

    { "name": "multi-choice contains", "condition": { "field": "tags", "op": "contains", "value": "a" }, "record": { "tags": ["a", "b"] }, "expected": true },
    { "name": "multi-choice contains misses", "condition": { "field": "tags", "op": "contains", "value": "c" }, "record": { "tags": ["a", "b"] }, "expected": false },
    { "name": "multi-choice in holds any of", "condition": { "field": "tags", "op": "in", "value": ["c", "b"] }, "record": { "tags": ["a", "b"] }, "expected": true },
    { "name": "multi-choice in on an empty list", "condition": { "field": "tags", "op": "in", "value": ["a"] }, "record": { "tags": [] }, "expected": false },
    { "name": "multi-choice is_empty on an empty list", "condition": { "field": "tags", "op": "is_empty" }, "record": { "tags": [] }, "expected": true },
    { "name": "multi-choice is_empty on absent", "condition": { "field": "tags", "op": "is_empty" }, "record": {}, "expected": true },
    { "name": "multi-choice is_not_empty", "condition": { "field": "tags", "op": "is_not_empty" }, "record": { "tags": ["a"] }, "expected": true },

    { "name": "lookup eq", "condition": { "field": "account", "op": "eq", "value": "0192a4b0-0000-7000-8000-000000000001" }, "record": { "account": "0192a4b0-0000-7000-8000-000000000001" }, "expected": true },
    { "name": "lookup eq misses", "condition": { "field": "account", "op": "eq", "value": "0192a4b0-0000-7000-8000-000000000001" }, "record": { "account": "0192a4b0-0000-7000-8000-000000000002" }, "expected": false },
    { "name": "lookup in", "condition": { "field": "account", "op": "in", "value": ["0192a4b0-0000-7000-8000-000000000001", "0192a4b0-0000-7000-8000-000000000002"] }, "record": { "account": "0192a4b0-0000-7000-8000-000000000002" }, "expected": true },
    { "name": "lookup ne on empty field is true", "condition": { "field": "account", "op": "ne", "value": "0192a4b0-0000-7000-8000-000000000001" }, "record": {}, "expected": true },
    { "name": "owner_ref is a lookup", "condition": { "field": "owner_ref", "op": "eq", "value": "0192a4b0-0000-7000-8000-0000000000aa" }, "record": { "owner_ref": "0192a4b0-0000-7000-8000-0000000000aa" }, "expected": true },

    { "name": "all needs every child", "condition": { "all": [ { "field": "status", "op": "eq", "value": "closed" }, { "field": "amount", "op": "gt", "value": 10000 } ] }, "record": { "status": "closed", "amount": 500 }, "expected": false },
    { "name": "any needs one child", "condition": { "any": [ { "field": "status", "op": "eq", "value": "closed" }, { "field": "amount", "op": "gt", "value": 10000 } ] }, "record": { "status": "closed", "amount": 500 }, "expected": true },
    { "name": "nested groups (design example)", "condition": { "any": [ { "all": [ { "field": "status", "op": "eq", "value": "closed" }, { "field": "amount", "op": "gt", "value": 10000 } ] }, { "field": "title", "op": "in", "value": ["eu", "uk"] } ] }, "record": { "status": "open", "amount": 20000, "title": "UK" }, "expected": true },
    { "name": "nested groups all false", "condition": { "any": [ { "all": [ { "field": "status", "op": "eq", "value": "closed" }, { "field": "amount", "op": "gt", "value": 10000 } ] }, { "field": "title", "op": "in", "value": ["eu", "uk"] } ] }, "record": { "status": "open", "amount": 20000, "title": "us" }, "expected": false }
  ]
}
