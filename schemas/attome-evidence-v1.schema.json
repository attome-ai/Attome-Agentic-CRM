{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attome.io/schemas/attome-evidence-v1.schema.json",
  "title": "attome-evidence/v1 (signed)",
  "description": "AB4-T2: a drill's signed evidence. The signature is Ed25519 over the evidence's canonical JSON (keys sorted, compact); key_id is the first 16 hex characters of the SHA-256 of the public key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence",
    "key_id",
    "signature"
  ],
  "properties": {
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "signature": {
      "type": "string",
      "description": "Base64 Ed25519 signature."
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "drill_id",
        "started_at",
        "finished_at",
        "platform_version",
        "checks",
        "restore_ok",
        "provenance_ok",
        "overall_ok"
      ],
      "properties": {
        "schema": {
          "const": "attome-evidence/v1"
        },
        "kind": {
          "enum": [
            "restore",
            "failover",
            "chaos",
            "upgrade",
            "secrets",
            "recovery",
            "drain"
          ]
        },
        "drill_id": {
          "type": "string",
          "format": "uuid"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "platform_version": {
          "type": "string"
        },
        "image_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "deployment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "rpo_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "rto_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "data_size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "restore_ok": {
          "type": "boolean"
        },
        "provenance_ok": {
          "type": "boolean"
        },
        "overall_ok": {
          "type": "boolean",
          "description": "No check failed or was skipped; for a restore, the restore and its provenance held too."
        },
        "extra": {
          "type": "object",
          "description": "What a kind records beyond these fields."
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "result"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "skipped"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
