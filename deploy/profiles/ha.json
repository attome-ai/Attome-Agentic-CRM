{
  "_comment": "U2-T1: a deployment profile for `attome cluster plan`. Sizes are proposals from loadtest/profiles.json's reference machines until AA2 measures them.",
  "name": "ha",
  "description": "Opt-in high availability (V2-D100): two servers behind the TLS edge, two workers, PgBouncer in front of PostgreSQL with a read replica, and the cache.",
  "services": [
    {
      "name": "server",
      "role": "server",
      "replicas": 2,
      "cpu_percent": 600,
      "memory_mb": 8192
    },
    {
      "name": "worker",
      "role": "worker",
      "replicas": 2,
      "cpu_percent": 300,
      "memory_mb": 4096
    },
    {
      "name": "pgbouncer",
      "role": "pgbouncer",
      "replicas": 1,
      "cpu_percent": 50,
      "memory_mb": 256
    },
    {
      "name": "postgres",
      "role": "postgres",
      "replicas": 2,
      "cpu_percent": 400,
      "memory_mb": 32768
    },
    {
      "name": "cache",
      "role": "cache",
      "replicas": 1,
      "cpu_percent": 100,
      "memory_mb": 4096
    }
  ],
  "settings": {
    "jobs.run_worker_inline": false,
    "database.node_count": 4,
    "database.connection_number": 40,
    "database.replica_max_lag_secs": 5
  }
}
