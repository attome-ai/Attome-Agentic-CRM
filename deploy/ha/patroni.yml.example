# AB2-T2: Patroni for the main database cluster, when a deployment runs one
# (reliability is opt-in, V2-D100: one database server is the normal case).
# One file per database node: change `name` and the connect addresses. Run
# three nodes and a three-member etcd so a failover keeps a majority.
#
# Passwords never go in this file: Patroni reads them from the environment
# (PATRONI_SUPERUSER_PASSWORD, PATRONI_REPLICATION_PASSWORD,
# PATRONI_REWIND_PASSWORD).

scope: attome                 # the cluster's name
namespace: /service/
name: db1

restapi:
  listen: 0.0.0.0:8008
  connect_address: db1:8008

etcd3:
  hosts: etcd1:2379,etcd2:2379,etcd3:2379

# Fencing. `required`: Patroni does not take the leader lock without a
# working watchdog, so a primary that stops answering (a hung host, a
# paused VM) is reset by the watchdog before another node is promoted, and
# two primaries never take writes at once. On a host with no hardware
# watchdog, load the kernel's software one first (`modprobe softdog`, and
# give the Patroni user access to /dev/watchdog).
watchdog:
  mode: required
  device: /dev/watchdog
  safety_margin: 5

bootstrap:
  dcs:
    ttl: 20
    loop_wait: 5
    retry_timeout: 5
    # Only a replica that has every committed change may be promoted.
    maximum_lag_on_failover: 0
    # Each commit waits for one replica to confirm it, so a failover loses
    # nothing. `synchronous_mode_strict: false` keeps writes flowing when the
    # only replica is down: the primary then commits alone, and a failover
    # in that window can lose what it committed (a non-zero recovery point;
    # the AB3 drills measure it). Set it to true to refuse writes instead.
    synchronous_mode: true
    synchronous_mode_strict: false
    synchronous_node_count: 1
    postgresql:
      # A former primary rejoins as a replica by rewinding to the new
      # timeline instead of being rebuilt from a full copy.
      use_pg_rewind: true
      remove_data_directory_on_rewind_failure: false
      use_slots: true
      parameters:
        wal_level: replica
        hot_standby: "on"
        wal_log_hints: "on"        # pg_rewind needs it (or data checksums)
        max_wal_senders: 10
        max_replication_slots: 10
  initdb:
    - encoding: UTF8
    - data-checksums

postgresql:
  listen: 0.0.0.0:5432
  connect_address: db1:5432
  data_dir: /var/lib/postgresql/data
  use_pg_rewind: true
  remove_data_directory_on_rewind_failure: false
  authentication:
    superuser:
      username: postgres
    replication:
      username: replicator
    rewind:
      username: rewind_user
  pg_hba:
    - host replication replicator 0.0.0.0/0 scram-sha-256
    - host all all 0.0.0.0/0 scram-sha-256

tags:
  nofailover: false
  noloadbalance: false
