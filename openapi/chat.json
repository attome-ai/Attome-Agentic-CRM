    "/api/v1/chat/channels/{id}/messages": {
      "get": {
        "tags": [
          "chat"
        ],
        "summary": "List a channel's messages",
        "description": "Top-level messages newest first, or one thread's replies oldest first. Members only; anyone else\ngets 404.",
        "operationId": "list_channel_messages",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The channel",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
