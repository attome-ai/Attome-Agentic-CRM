          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Messages per page, 1 to 200 (default 50).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "thread",
            "in": "query",
