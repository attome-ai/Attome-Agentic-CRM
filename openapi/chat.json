{
  "openapi": "3.1.0",
  "info": {
    "title": "Attome XRM API",
    "description": "The Attome XRM platform's HTTP API. Entity record shapes under `/api/v1/{entity}` are resolved from each deployment's runtime metadata (D-003) and therefore cannot be enumerated statically — those operations document the generic envelope only. Fetch `GET /api/v1/schema/{logicalname}` for a live entity's fields.",
    "contact": {
      "name": "Automatica Tech Solutions"
    },
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "x-api-version": "2026-10",
  "paths": {
    "/api/v1/chat/channels": {
      "get": {
        "tags": [
          "chat"
        ],
        "summary": "List my chat channels",
        "description": "The channels the signed-in person is a member of, most recently active first, one-based pages.",
        "operationId": "list_channels",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "One-based (D-347): page 1 is the first page. Values below 1 are\nclamped up to 1 rather than rejected, matching the legacy lists.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Rows per page, clamped to `1..=MAX_PAGE_SIZE`. Defaults to\n`DEFAULT_PAGE_SIZE`.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedResponse_ChannelRow"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-cache": "private-revalidate",
        "x-idempotent": "natural",
        "x-module": "chat",
        "x-privilege": "authenticated",
        "x-rate-class": "api",
        "x-risk": "low"
      },
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Start a chat channel",
        "description": "A direct channel (one per pair of people; asking again returns the same one), a named group, or a\nchannel on a record, whose members must each be able to read the record.",
        "operationId": "post_channel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewChannel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The pair's existing direct channel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelRow"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelRow"
                }
