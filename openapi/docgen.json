{
  "openapi": "3.1.0",
  "info": {
    "title": "Attome XRM API",
    "description": "The Attome XRM platform's HTTP API. Entity record shapes under `/api/v1/{entity}` are resolved from each deployment's runtime metadata (D-003) and therefore cannot be enumerated statically — those operations document the generic envelope only. Fetch `GET /api/v1/schema/{logicalname}` for a live entity's fields.",
    "contact": {
      "name": "Automatica Tech Solutions"
    },
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "x-api-version": "2026-10",
  "paths": {
    "/api/v1/admin/templates/preview": {
      "post": {
        "tags": [
          "docgen"
        ],
        "summary": "Preview a document template",
        "description": "Renders a template against a real record read as the caller, so it sees only what the caller may\nread, and warns about every field it names that renders empty for that reason; an unknown field or\na syntax error is refused. Writes nothing. Content administrators only.",
        "operationId": "preview_template",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreviewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The rendered template and the fields that rendered empty",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreviewResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller is not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such record, or the caller may not read it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The template does not compile or render; the message names where",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-audit-exempt": {
          "note": "renders a preview; writes nothing",
          "reason": "dry_run",
          "via": null
        },
        "x-cache": "no-store",
        "x-idempotent": "key",
        "x-module": "docgen",
        "x-privilege": "admin",
        "x-rate-class": "api",
        "x-risk": "medium"
      }
    },
    "/api/v1/docgen/batches/{batch_id}": {
      "get": {
        "tags": [
          "docgen"
        ],
        "summary": "A render batch's progress (K3-T3).",
        "description": "How many of its renders are pending, running, completed (and attached)\nor failed. The person who started it and administrators see it; anyone\nelse gets 404.",
        "operationId": "batch_status",
        "parameters": [
          {
            "name": "batch_id",
            "in": "path",
            "description": "The batch's id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The batch's progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenderBatchStatus"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the required privilege",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such batch, or not one the caller started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-cache": "private-revalidate",
        "x-idempotent": "natural",
        "x-module": "docgen",
        "x-privilege": "authenticated",
        "x-rate-class": "api",
        "x-risk": "low"
      }
    },
    "/api/v1/docgen/renders/{render_id}": {
      "get": {
        "tags": [
          "docgen"
        ],
        "summary": "Read a document render",
        "description": "A render's status and, once done, its document.",
        "operationId": "render_status",
        "parameters": [
          {
            "name": "render_id",
            "in": "path",
            "description": "The render",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenderStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the required privilege",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such render",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-cache": "private-revalidate",
        "x-idempotent": "natural",
        "x-module": "docgen",
        "x-privilege": "authenticated",
        "x-rate-class": "api",
        "x-risk": "low"
      }
    },
    "/api/v1/docgen/templates/{id}/render": {
      "post": {
        "tags": [
          "docgen"
        ],
        "summary": "Render a document template",
        "description": "Queues a render (202) of the template against a record, read as the caller so it sees only what\nthe caller may read.",
        "operationId": "render_document",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The template",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderTemplateBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenderEnqueueResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the required privilege",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such template",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-audit-exempt": {
          "note": "the route only enqueues a render; the job writes entity+export in the render's completion transaction",
          "reason": "delegated",
          "via": "EngineJob::DocgenRender"
        },
        "x-cache": "no-store",
        "x-idempotent": "key",
        "x-module": "docgen",
        "x-privilege": "authenticated",
        "x-rate-class": "api",
        "x-risk": "medium"
      }
    },
    "/api/v1/docgen/templates/{id}/render-batch": {
      "post": {
        "tags": [
          "docgen"
        ],
        "summary": "Renders one template for many records (K3-T3).",
        "description": "One render per record, each its own job, so one failing record does not\nstop the others and each retries on its own; each renders as the caller,\nsees only what the caller may see, and is attached to its record when the\ntemplate names an `attach_to_field`. Answers the batch id;\n`GET /api/v1/docgen/batches/{id}` shows its progress.",
        "operationId": "render_batch",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The template's id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderBatchBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "The renders are queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenderBatchStatus"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the required privilege",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such template",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "No records, more than 500, or a template that cannot render",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-audit-exempt": {
          "note": "the route only enqueues renders; each job writes its entity and export events in its completion transaction",
          "reason": "delegated",
          "via": "EngineJob::DocgenRender"
        },
        "x-cache": "no-store",
        "x-idempotent": "key",
        "x-module": "docgen",
        "x-privilege": "authenticated",
        "x-rate-class": "api",
        "x-risk": "medium"
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorDetails": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          {
            "$ref": "#/components/schemas/RuleViolationDetails"
          },
          {
            "$ref": "#/components/schemas/FieldLockedDetails"
          }
        ],
        "description": "`ErrorResponse.details`: its shape depends on the `error` code —\na list of [`FieldError`] on `validation_error`, [`RuleViolationDetails`] on\n`rule_violation`, [`FieldLockedDetails`] on `field_locked` and\n`field_locked_required` (D-789)."
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error envelope. `error` is a stable machine-readable code; `message` is human-readable and never contains internal detail.",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ],
            "description": "The same value as `error`."
          },
          "current_state": {
            "description": "Present on a version conflict: the server's current row for the\nfields the caller touched, as a JSON object. The owning engine filters\nsensitive columns out before building it (BTY-16c's precondition), so\nthis is a deliberate filtered projection — never a raw row dump."
          },
          "current_version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Present on a version conflict: the `row_version` the server currently\nholds, so a caller can re-read and retry instead of guessing what the\nwinner wrote. Omitted when the conflict is not version-based."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "The same text as `message`."
          },
          "details": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ErrorDetails",
                "description": "Structured detail, shaped by `error` (see [`ErrorDetails`]): every\nfield-level failure on a `validation_error` response when the raiser\nhas a field list, so a form can render them all at once; every firing\nrule on a `rule_violation` response from a business rule; every\nrefused field on `field_locked` / `field_locked_required`. Omitted\notherwise."
              }
            ]
          },
          "effect": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present on `field_locked` / `field_locked_required`: `hidden` or\n`disabled`."
          },
          "error": {
            "type": "string",
            "description": "Stable machine-readable code — `not_found`, `unauthorized`, `forbidden`,\n`attribute_not_writable`, `limit_exceeded`,\n`conflict`, `version_conflict`, `duplicate_detected`, `idempotency_conflict`,\n`validation_error`, `customer_tests_failed`, `feature_unavailable`, `feature_hidden`,\n`rate_limit_exceeded`, `overloaded`, `capability_unavailable`,\n`metadata_authoring_locked`, `transition_not_allowed`,\n`rule_violation`, `field_locked`, `field_locked_required`,\n`reauth_required`, `server_timeout`, `query_timeout`, `read_only`, `payload_too_large`,\n`request_rejected`, `invalid_cursor`, `resync_needed`, `cascade_restricted`,\n`idempotency_outcome_unknown`, `idempotency_replay_unavailable`,\n`method_not_allowed`, or\n`internal_error` — one per `AppError` variant (`FieldLocked` answers\ntwo: plain and required) (`attome-types/src/error.rs`); M01 Core C-23\nfound this list four codes short of the taxonomy it documents."
          },
          "errors": {
            "type": [
              "array",
              "null"
            ],
            "items": {},
            "description": "Every field-level failure on a `validation_error`, as\n`{attribute, rule, message, fix}`."
          },
          "field": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present on `field_locked` / `field_locked_required` (D-789): the first\nrefused field (every one is in `details.fields`); on\n`attribute_not_writable` (Q15-T4): the attribute the caller may not\nwrite."
          },
          "hidden": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Present on `duplicate_detected`: how many more matches the caller may\nnot read."
          },
          "instance": {
            "type": [
              "string",
              "null"
            ],
            "description": "The request path the problem happened at."
          },
          "matches": {
            "description": "Present on `duplicate_detected` (A15-T4): the existing records the\nsave matches that the caller may read (record, rule, score)."
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present on responses that passed through the request-id middleware\n(D-043); absent on the few pre-middleware rejection paths."
          },
          "retry_after_sec": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Present on a `rate_limit_exceeded` response when the limiter knows its\nwindow: seconds to wait before retrying, equal by construction to the\n`Retry-After` header on the same response (BTY-11a). Omitted when the\nlimit that was hit has no known window.",
            "minimum": 0
          },
          "retryable": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the same request may succeed later (the error catalogue's\nverdict for `code`)."
          },
          "rule_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Present on a `rule_violation` response (D-472): the id of the\n`xrm_core_rule` whose failing expression produced this 422, so a\nclient can highlight or re-check the exact rule without parsing\n`message`. Omitted on every other code, and on any response that\ndoes not name a rule.\nAlso present on `field_locked` / `field_locked_required` (D-789): the\nbusiness rule that locks `field`."
          },
          "rule_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present on `field_locked` / `field_locked_required`: the display name\nof the rule that locks `field`."
          },
          "status": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "The HTTP status code.",
            "minimum": 0
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "A short title for `code` in the request's language (Z14-T3), e.g.\n`The resource was not found.`"
          },
          "type": {
            "type": [
              "string",
              "null"
            ],
            "description": "Z14-T1 (RFC 9457): `about:blank`; the problem is named by `code`."
          }
        },
        "example": {
          "error": "validation_error",
          "message": "validation error: name is required",
          "request_id": "018f0a1b-2c3d-7e4f-8a9b-0c1d2e3f4a5b"
        }
      },
      "FieldError": {
        "type": "object",
        "description": "One field-level failure inside `ErrorResponse.details` (BTY-16b): the\nfield the caller sent, a stable machine-readable `code` the client maps\nto localized text (e.g. `required`, `too_long`, `invalid_format`,\n`not_allowed`), and the English server-side `message`.\n\nA list, not a single error, so one 422 can answer with every bad field at\nonce (BTY-F11) instead of making a form discover them one round-trip at a\ntime.",
        "required": [
          "field",
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable failure code for this field, independent of\nthe message text."
          },
          "field": {
            "type": "string",
            "description": "The offending field, as the caller addressed it (e.g. `email` or\n`amount`)."
          },
          "message": {
            "type": "string",
            "description": "Human-readable, English, server-side detail for this field."
          }
        }
      },
      "FieldLockedDetails": {
        "type": "object",
        "description": "`details` of a `field_locked` / `field_locked_required` response: every\nrefused field, the first being the one the top-level `field` names.",
        "required": [
          "fields"
        ],
        "properties": {
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LockedField"
            }
          }
        }
      },
      "LockedField": {
        "type": "object",
        "description": "One field a business rule locks for the writer (D-789 §3.5): `effect` is\n`hidden` or `disabled`. No value is ever echoed.",
        "required": [
          "field",
          "rule_id",
          "rule_name",
          "effect"
        ],
        "properties": {
          "effect": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "rule_id": {
            "type": "string",
            "format": "uuid"
          },
          "rule_name": {
            "type": "string"
          }
        }
      },
      "PreviewOutput": {
        "type": "string",
        "description": "The output a preview renders.",
        "enum": [
          "html",
          "text"
        ]
      },
      "PreviewRequest": {
        "type": "object",
        "description": "`POST /api/v1/admin/templates/preview`'s body.",
        "required": [
          "template",
          "entity",
          "record_id"
        ],
        "properties": {
          "entity": {
            "type": "string",
            "description": "The record's entity (logical name)."
          },
          "language": {
            "type": [
              "string",
              "null"
            ],
            "description": "The render's locale, e.g. `ar-SA`; the deployment's when unset."
          },
          "output": {
            "$ref": "#/components/schemas/PreviewOutput"
          },
          "record_id": {
            "type": "string",
            "format": "uuid"
          },
          "template": {
            "type": "string",
            "description": "The template source."
          }
        }
      },
      "PreviewResponse": {
        "type": "object",
        "description": "The rendered preview.",
        "required": [
          "rendered",
          "warnings"
        ],
        "properties": {
          "rendered": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PreviewWarning"
            }
          }
        }
      },
      "PreviewWarning": {
        "type": "object",
        "description": "One field the template names that rendered empty for this caller.",
        "required": [
          "field",
          "reason"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "description": "`unreadable`: the caller may not read it on this record."
          }
        }
      },
      "RenderBatchBody": {
        "type": "object",
        "description": "`POST /api/v1/docgen/templates/{id}/render-batch`.",
        "required": [
          "record_ids"
        ],
        "properties": {
          "record_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The records to render, 1 to 500; a repeated id renders once."
          }
        }
      },
      "RenderBatchStatus": {
        "type": "object",
        "description": "A batch's progress.",
        "required": [
          "batch_id",
          "total",
          "pending",
          "running",
          "completed",
          "failed",
          "attached"
        ],
        "properties": {
          "attached": {
            "type": "integer",
            "format": "int64",
            "description": "Completed renders attached to their record."
          },
          "batch_id": {
            "type": "string",
            "format": "uuid"
          },
          "completed": {
            "type": "integer",
            "format": "int64"
          },
          "failed": {
            "type": "integer",
            "format": "int64"
          },
          "pending": {
            "type": "integer",
            "format": "int64"
          },
          "running": {
            "type": "integer",
            "format": "int64"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "RenderEnqueueResponse": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
