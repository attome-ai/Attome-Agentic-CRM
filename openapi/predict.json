        "operationId": "list_predictions",
        "parameters": [
          {
            "name": "regarding_entity",
            "in": "query",
            "description": "Only records of this entity.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "regarding_id",
            "in": "query",
            "description": "Only this record.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "One-based: page 1 is the first page.",
