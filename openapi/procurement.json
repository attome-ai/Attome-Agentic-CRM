    "/api/v1/procurement/purchase-orders/{id}/cancel": {
      "post": {
        "tags": [
          "procurement"
        ],
        "summary": "Cancels a purchase order.",
        "description": "A draft or issued order releases its budget commitment with the status change.",
        "operationId": "post_purchase_order_cancel",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The record",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "What the step did",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcurementStep"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the privilege",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such record, or procurement budgets are not installed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Not in a status this step starts from, or being changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Over budget, no rule or vendor, or a bad amount",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
