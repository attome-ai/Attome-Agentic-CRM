{
  "openapi": "3.1.0",
  "info": {
    "title": "Attome XRM API",
    "description": "The Attome XRM platform's HTTP API. Entity record shapes under `/api/v1/{entity}` are resolved from each deployment's runtime metadata (D-003) and therefore cannot be enumerated statically — those operations document the generic envelope only. Fetch `GET /api/v1/schema/{logicalname}` for a live entity's fields.",
    "contact": {
      "name": "Automatica Tech Solutions"
    },
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "x-api-version": "2026-10",
  "paths": {
    "/api/v1/callintel/calls/{activity_id}": {
      "get": {
        "tags": [
          "callintel"
        ],
        "summary": "A call's analysis",
        "description": "D22-T8: the latest analysis of a call with its findings and scorecard answers; talk patterns only\nfor the call's owner and their managers.",
        "operationId": "call_page",
        "parameters": [
          {
            "name": "activity_id",
            "in": "path",
            "description": "The call (activity)",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The call page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallPage"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks call_analysis.read or cannot read the call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such call, or not analysed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-cache": "private-revalidate",
        "x-idempotent": "natural",
        "x-module": "callintel",
        "x-privilege": "authenticated",
        "x-rate-class": "api",
        "x-risk": "low"
      }
    },
    "/api/v1/callintel/calls/{activity_id}/comments": {
      "post": {
        "tags": [
          "callintel"
        ],
        "summary": "Comment on a call",
        "description": "D22-T8: the owner, their managers or a peer holding call_comment.create comments at a moment of\nthe call; the owner is notified.",
        "operationId": "comment",
        "parameters": [
          {
            "name": "activity_id",
            "in": "path",
            "description": "The call (activity)",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommentBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The comment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentMade"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed to comment on this call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such call, or not analysed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "An empty or too long comment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-audit": {
          "events": [
            {
              "category": "business_event",
              "operation": "create"
            }
          ],
          "policy": "entity_policy"
        },
        "x-cache": "no-store",
        "x-idempotent": "key",
        "x-module": "callintel",
        "x-privilege": "authenticated",
        "x-rate-class": "api",
        "x-risk": "medium"
      }
    },
    "/api/v1/callintel/calls/{activity_id}/recording": {
      "get": {
        "tags": [
          "callintel"
        ],
        "summary": "Play a call's recording",
        "description": "D22-T8: a short-lived URL of the call's recording; each playback is audited.",
        "operationId": "recording",
        "parameters": [
          {
            "name": "activity_id",
            "in": "path",
            "description": "The call (activity)",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Where to play it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recording"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks call_analysis.read or cannot read the call or recording",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such call, or no recording",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-cache": "private-revalidate",
        "x-idempotent": "natural",
        "x-module": "callintel",
        "x-privilege": "authenticated",
        "x-rate-class": "api",
        "x-risk": "low"
      }
    },
    "/api/v1/callintel/findings/{id}/task": {
      "post": {
        "tags": [
          "callintel"
        ],
        "summary": "Make a task from a finding",
        "description": "D22-T8: a next step (or any finding) as a task for the call's owner, made once.",
        "operationId": "finding_task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The finding",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskMade"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks call_analysis.read or activity.create",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such finding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "A task is being made from it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-audit": {
          "events": [
            {
              "category": "business_event",
              "operation": "create"
            }
          ],
          "policy": "entity_policy"
        },
        "x-cache": "no-store",
        "x-idempotent": "key",
        "x-module": "callintel",
        "x-privilege": "authenticated",
        "x-rate-class": "api",
        "x-risk": "medium"
      }
    },
    "/api/v1/callintel/my-analyses": {
      "get": {
        "tags": [
          "callintel"
        ],
        "summary": "The analyses about my calls",
        "description": "D22-T13: every analysis whose call the caller owns, newest first: staff see all that is analysed\nabout them. No analysis carries a sentiment for staff.",
        "operationId": "my_analyses",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "One-based (D-347): page 1 is the first page. Values below 1 are\nclamped up to 1 rather than rejected, matching the legacy lists.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Rows per page, clamped to `1..=MAX_PAGE_SIZE`. Defaults to\n`DEFAULT_PAGE_SIZE`.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The caller's analyses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedResponse_MyAnalysis"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-cache": "private-revalidate",
        "x-idempotent": "natural",
        "x-module": "callintel",
        "x-privilege": "authenticated",
        "x-rate-class": "api",
        "x-risk": "low"
      }
    },
    "/api/v1/callintel/scorecard-answers/{id}/confirm": {
      "post": {
        "tags": [
          "callintel"
        ],
        "summary": "Confirm a scorecard answer",
        "description": "D22-T8: a manager of the call's owner confirms an answer.",
        "operationId": "confirm_scorecard_answer",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The scorecard answer",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Confirmed"
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not a manager of the call's owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The answer changed since it was read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Not yes, no or unclear",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-audit": {
          "events": [
            {
              "category": "business_event",
              "operation": "update"
            }
          ],
          "policy": "entity_policy"
        },
        "x-cache": "no-store",
        "x-idempotent": "key",
        "x-module": "callintel",
        "x-privilege": "authenticated",
        "x-rate-class": "api",
        "x-risk": "medium"
      }
    }
  },
  "components": {
    "schemas": {
      "CallPage": {
        "type": "object",
        "description": "A call page.",
        "required": [
          "activity_id",
          "analysis_id",
          "findings",
          "scorecard",
          "transcript"
        ],
        "properties": {
          "activity_id": {
            "type": "string",
            "format": "uuid"
          },
          "analysis_id": {
            "type": "string",
            "format": "uuid"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "scorecard": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "talk": {
            "type": [
              "object",
              "null"
            ],
            "description": "Only for the call's owner and their managers."
          },
          "transcript": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "D22-T12: the redacted transcript, `[{start_ms, end_ms, speaker, text}]`."
          }
        }
      },
      "CommentBody": {
        "type": "object",
        "required": [
          "at_ms",
          "body"
        ],
        "properties": {
          "at_ms": {
            "type": "integer",
            "format": "int64",
            "description": "The moment of the call, in milliseconds."
          },
          "body": {
            "type": "string"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "CommentMade": {
        "type": "object",
        "description": "A comment made.",
        "required": [
          "comment_id"
        ],
        "properties": {
          "comment_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ConfirmBody": {
        "type": "object",
        "required": [
          "value",
          "row_version"
        ],
        "properties": {
          "row_version": {
            "type": "integer",
            "format": "int64",
            "description": "The answer's `row_version` as read."
          },
          "value": {
            "type": "string",
            "description": "`yes`, `no` or `unclear`."
          }
        }
      },
      "ErrorDetails": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          {
            "$ref": "#/components/schemas/RuleViolationDetails"
          },
          {
            "$ref": "#/components/schemas/FieldLockedDetails"
          }
        ],
        "description": "`ErrorResponse.details`: its shape depends on the `error` code —\na list of [`FieldError`] on `validation_error`, [`RuleViolationDetails`] on\n`rule_violation`, [`FieldLockedDetails`] on `field_locked` and\n`field_locked_required` (D-789)."
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error envelope. `error` is a stable machine-readable code; `message` is human-readable and never contains internal detail.",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ],
            "description": "The same value as `error`."
          },
          "current_state": {
            "description": "Present on a version conflict: the server's current row for the\nfields the caller touched, as a JSON object. The owning engine filters\nsensitive columns out before building it (BTY-16c's precondition), so\nthis is a deliberate filtered projection — never a raw row dump."
          },
          "current_version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Present on a version conflict: the `row_version` the server currently\nholds, so a caller can re-read and retry instead of guessing what the\nwinner wrote. Omitted when the conflict is not version-based."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "The same text as `message`."
          },
          "details": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ErrorDetails",
                "description": "Structured detail, shaped by `error` (see [`ErrorDetails`]): every\nfield-level failure on a `validation_error` response when the raiser\nhas a field list, so a form can render them all at once; every firing\nrule on a `rule_violation` response from a business rule; every\nrefused field on `field_locked` / `field_locked_required`. Omitted\notherwise."
              }
            ]
          },
          "effect": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present on `field_locked` / `field_locked_required`: `hidden` or\n`disabled`."
          },
          "error": {
            "type": "string",
            "description": "Stable machine-readable code — `not_found`, `unauthorized`, `forbidden`,\n`attribute_not_writable`, `limit_exceeded`,\n`conflict`, `version_conflict`, `duplicate_detected`, `idempotency_conflict`,\n`validation_error`, `customer_tests_failed`, `governance_roles_held`, `feature_unavailable`, `feature_hidden`,\n`rate_limit_exceeded`, `overloaded`, `capability_unavailable`,\n`metadata_authoring_locked`, `transition_not_allowed`,\n`rule_violation`, `field_locked`, `field_locked_required`,\n`reauth_required`, `server_timeout`, `query_timeout`, `read_only`, `payload_too_large`,\n`request_rejected`, `invalid_cursor`, `resync_needed`, `cascade_restricted`,\n`idempotency_outcome_unknown`, `idempotency_replay_unavailable`,\n`method_not_allowed`, or\n`internal_error` — one per `AppError` variant (`FieldLocked` answers\ntwo: plain and required) (`attome-types/src/error.rs`); M01 Core C-23\nfound this list four codes short of the taxonomy it documents."
          },
          "errors": {
            "type": [
              "array",
              "null"
            ],
            "items": {},
            "description": "Every field-level failure on a `validation_error`, as\n`{attribute, rule, message, fix}`."
          },
          "field": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present on `field_locked` / `field_locked_required` (D-789): the first\nrefused field (every one is in `details.fields`); on\n`attribute_not_writable` (Q15-T4): the attribute the caller may not\nwrite."
          },
          "hidden": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Present on `duplicate_detected`: how many more matches the caller may\nnot read."
          },
          "instance": {
            "type": [
              "string",
              "null"
            ],
            "description": "The request path the problem happened at."
          },
          "matches": {
            "description": "Present on `duplicate_detected` (A15-T4): the existing records the\nsave matches that the caller may read (record, rule, score)."
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present on responses that passed through the request-id middleware\n(D-043); absent on the few pre-middleware rejection paths."
          },
          "retry_after_sec": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Present on a `rate_limit_exceeded` response when the limiter knows its\nwindow: seconds to wait before retrying, equal by construction to the\n`Retry-After` header on the same response (BTY-11a). Omitted when the\nlimit that was hit has no known window.",
            "minimum": 0
          },
          "retryable": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the same request may succeed later (the error catalogue's\nverdict for `code`)."
          },
          "rule_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Present on a `rule_violation` response (D-472): the id of the\n`xrm_core_rule` whose failing expression produced this 422, so a\nclient can highlight or re-check the exact rule without parsing\n`message`. Omitted on every other code, and on any response that\ndoes not name a rule.\nAlso present on `field_locked` / `field_locked_required` (D-789): the\nbusiness rule that locks `field`."
          },
          "rule_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present on `field_locked` / `field_locked_required`: the display name\nof the rule that locks `field`."
          },
          "status": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "The HTTP status code.",
            "minimum": 0
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "A short title for `code` in the request's language (Z14-T3), e.g.\n`The resource was not found.`"
          },
          "type": {
            "type": [
              "string",
              "null"
            ],
            "description": "Z14-T1 (RFC 9457): `about:blank`; the problem is named by `code`."
          }
        },
        "example": {
          "error": "validation_error",
          "message": "validation error: name is required",
          "request_id": "018f0a1b-2c3d-7e4f-8a9b-0c1d2e3f4a5b"
        }
      },
      "FieldError": {
        "type": "object",
        "description": "One field-level failure inside `ErrorResponse.details` (BTY-16b): the\nfield the caller sent, a stable machine-readable `code` the client maps\nto localized text (e.g. `required`, `too_long`, `invalid_format`,\n`not_allowed`), and the English server-side `message`.\n\nA list, not a single error, so one 422 can answer with every bad field at\nonce (BTY-F11) instead of making a form discover them one round-trip at a\ntime.",
        "required": [
          "field",
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable failure code for this field, independent of\nthe message text."
          },
          "field": {
            "type": "string",
            "description": "The offending field, as the caller addressed it (e.g. `email` or\n`amount`)."
          },
          "message": {
            "type": "string",
            "description": "Human-readable, English, server-side detail for this field."
          }
        }
      },
      "FieldLockedDetails": {
        "type": "object",
        "description": "`details` of a `field_locked` / `field_locked_required` response: every\nrefused field, the first being the one the top-level `field` names.",
        "required": [
          "fields"
        ],
        "properties": {
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LockedField"
            }
          }
        }
      },
      "LockedField": {
        "type": "object",
        "description": "One field a business rule locks for the writer (D-789 §3.5): `effect` is\n`hidden` or `disabled`. No value is ever echoed.",
        "required": [
          "field",
          "rule_id",
          "rule_name",
          "effect"
        ],
        "properties": {
          "effect": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "rule_id": {
            "type": "string",
            "format": "uuid"
          },
          "rule_name": {
            "type": "string"
          }
        }
      },
      "PaginatedResponse_MyAnalysis": {
        "type": "object",
        "description": "The platform's canonical list envelope (guidelines §12). `total` is the size of the whole set, not of `items`. `page` echoes the page served; every offset list is one-based (D-793): page 1 is the first page. `warnings` is sent only when there is one (Z14-T6).",
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "One analysis about the caller's own call.",
              "required": [
                "analysis_id"
              ],
              "properties": {
                "activity_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "analysed_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "analysis_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "staff_questions": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "format": "double"
                },
                "staff_talk_share": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "format": "double"
                },
                "status": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "page": {
            "type": "integer",
            "format": "int64"
          },
          "page_size": {
            "type": "integer",
            "format": "int64"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Warning"
            },
            "description": "Z14-T6: what the caller should know though the list succeeded;\nomitted when empty."
          }
        }
      },
      "Recording": {
        "type": "object",
        "description": "A recording to play.",
        "required": [
          "download_url",
          "expires_in_secs"
        ],
        "properties": {
          "download_url": {
            "type": "string"
          },
          "expires_in_secs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "RuleFailure": {
        "type": "object",
        "description": "One business-rule `error` policy that fired (D-789 §3.3), inside a\n`rule_violation` body's `details.rules`. Carries names and the rule's own\nmessage, never a record value.",
        "required": [
          "rule_id",
          "rule_name",
          "message"
        ],
        "properties": {
          "field": {
            "type": [
              "string",
              "null"
            ],
            "description": "The field the policy is attached to, when it names one."
          },
          "message": {
            "type": "string"
          },
          "rule_id": {
            "type": "string",
            "format": "uuid"
          },
          "rule_name": {
            "type": "string",
            "description": "The rule's display name (its name when it has none)."
          }
        }
      },
      "RuleViolationDetails": {
        "type": "object",
        "description": "`details` of a `rule_violation` response (D-789): the field of the first\nfailing policy, when it names one, and every blocking `error` policy that\nfired, the first (by rule display order) being the one `rule_id` names.",
        "required": [
          "rules"
        ],
        "properties": {
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RuleFailure"
            }
          }
        }
      },
      "TaskMade": {
        "type": "object",
        "description": "A task made from a finding.",
        "required": [
          "task_id"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Warning": {
        "type": "object",
        "description": "Something the server did that the caller should know about though the\nrequest succeeded (a value truncated, a default applied, a page clamped):\na stable `code` and English `message`. Sent only when there is one.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "`Authorization: ApiKey <public_key>:<secret>`, issued by POST /api/v1/auth/api-keys."
      },
      "portal_session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-wp_{portal}_session",
        "description": "A web portal user's session cookie, issued by the portal's sign-in; `{portal}` is the portal's keyword (`wp_{portal}_session` on plain-http local dev). Valid only on that portal's own routes."
      },
      "s2s_hmac": {
        "type": "apiKey",
        "in": "header",
        "name": "x-s2s-signature",
        "description": "A system-to-system call, signed. Send `x-s2s-client-id`, `x-s2s-key-id`, `x-s2s-timestamp` (Unix milliseconds, within 300 seconds of the server's clock), `x-s2s-nonce` (single use: a repeat is refused) and `x-s2s-signature`: the hex HMAC-SHA256, keyed by the hex-decoded client secret, of `METHOD`, `PATH_AND_QUERY`, the hex SHA-256 of the body, `TIMESTAMP` and `NONCE`, joined by newlines in that order."
      },
      "session_cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-session_token",
        "description": "Browser session cookie issued by POST /api/v1/auth/login. Mutating requests additionally require the CSRF conditions enforced by `middleware::csrf`."
      }
    }
  },
  "tags": []
}
