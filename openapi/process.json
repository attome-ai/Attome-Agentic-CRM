  "components": {
    "schemas": {
      "CaseDefDetail": {
        "type": "object",
        "required": [
          "id",
          "name",
          "source",
          "activity_mapping",
          "resource_mapping",
          "is_active",
          "row_version",
          "created_at",
          "updated_at",
          "owner_layer"
        ],
        "properties": {
          "activity_mapping": {
            "description": "Interpretation depends on `source` — see `extraction.rs`'s doc\ncomment for the exact shape each source kind expects."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_active": {
            "type": "boolean"
          },
          "last_extracted_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "name": {
            "type": "string"
          },
          "owner_layer": {
            "type": "string",
            "description": "Solution 7 (D-785): the layer that owns this definition."
          },
          "resource_mapping": {},
          "row_version": {
            "type": "integer",
            "format": "int64"
          },
          "source": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "visibility_privilege": {
            "type": [
              "string",
              "null"
            ],
            "description": "M41 §5 Permissions — a privilege key aggregate DFG/variant views will\nrequire of the caller. Stored and schema-ready; enforcing it on a\nself-service (non-admin) read surface is Phase 2+ (Phase 1 exposes\nonly the admin-gated routes this crate mounts today)."
          }
        }
      },
      "ConformanceReport": {
        "type": "object",
        "description": "The result of a check.",
        "required": [
          "cases",
          "conforming",
          "fitness",
          "by_step",
          "deviations"
        ],
        "properties": {
          "by_step": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeviationCount"
            }
          },
          "cases": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "conforming": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "deviations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Deviation"
            }
          },
          "fitness": {
            "type": "number",
            "format": "double",
            "description": "`conforming / cases`, 1 for no cases."
          }
        }
      },
      "CreateCaseDefBody": {
        "type": "object",
        "required": [
          "name",
          "source"
        ],
        "properties": {
          "activity_mapping": {},
          "is_active": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "resource_mapping": {},
          "source": {
            "type": "string"
          },
          "visibility_privilege": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Deviation": {
        "type": "object",
        "description": "One step a case took that the model does not allow (`from` is `None` for\na wrong start).",
        "required": [
          "case_id",
          "to",
          "at"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "case_id": {
            "type": "string",
            "format": "uuid"
          },
