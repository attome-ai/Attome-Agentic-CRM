      },
      "FieldValueView": {
        "oneOf": [
          {
            "type": "object",
            "description": "The viewer is authorized to see this value, but this API does not\ndecrypt it yet — see this module's doc comment.",
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "encrypted"
                ]
              }
            }
          },
          {
            "type": "object",
