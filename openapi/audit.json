{
  "openapi": "3.1.0",
  "info": {
    "title": "Attome XRM API",
    "description": "The Attome XRM platform's HTTP API. Entity record shapes under `/api/v1/{entity}` are resolved from each deployment's runtime metadata (D-003) and therefore cannot be enumerated statically — those operations document the generic envelope only. Fetch `GET /api/v1/schema/{logicalname}` for a live entity's fields.",
    "contact": {
      "name": "Automatica Tech Solutions"
    },
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "x-api-version": "2026-10",
  "paths": {
    "/api/v1/admin/audit/events/{id}/proof": {
      "get": {
        "tags": [
          "admin-audit"
        ],
        "summary": "An audit event's inclusion proof.",
        "description": "The Merkle path from the event's hash to its sealed batch's signed root,\nwith the signature, the signing key's public half and the anchor key, so\nthe event can be checked without the database (see `crate::proof`).",
        "operationId": "audit_event_proof",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The audit event (audit_header) id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The inclusion proof",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InclusionProof"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the required privilege",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such audit event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The event is not sealed into a batch yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-cache": "private-revalidate",
        "x-idempotent": "natural",
        "x-module": "audit",
        "x-privilege": "admin",
        "x-rate-class": "api",
        "x-risk": "low"
      }
    },
    "/api/v1/admin/audit/evidence-packs": {
      "post": {
        "tags": [
          "admin-audit"
        ],
        "summary": "Builds an audit evidence pack.",
        "description": "Every sealed event in a time range or of one record (at most 2,000),\neach with its inclusion proof, the public signing keys and the steps to\nverify them offline. Building one is itself audited.",
        "operationId": "audit_evidence_pack",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidencePackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The evidence pack",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidencePack"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the required privilege",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "No range or record, or more than 2,000 events",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-audit": {
          "events": [
            {
              "category": "security",
              "operation": "download"
            }
          ],
          "policy": "mandatory"
        },
        "x-cache": "no-store",
        "x-idempotent": "key",
        "x-module": "audit",
        "x-privilege": "admin",
        "x-rate-class": "api",
        "x-risk": "medium"
      }
    },
    "/api/v1/admin/audit/export": {
      "get": {
        "tags": [
          "admin-audit"
        ],
        "summary": "Export the audit trail",
        "description": "Streams the filtered audit entries as JSON lines (default), CEF or CSV for a SIEM or an archive.\nAn administrator exports everything, a unit auditor only their units; the export is itself\naudited.",
        "operationId": "audit_export",
        "parameters": [
          {
            "name": "entity_name",
            "in": "query",
            "description": "Only this entity (its logical name).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "record_id",
            "in": "query",
            "description": "Only this record.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "user_id",
            "in": "query",
            "description": "Only this user.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "user_email",
            "in": "query",
            "description": "Only this user's entries, by email.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "operation",
            "in": "query",
            "description": "Only this operation.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "field_name",
            "in": "query",
            "description": "Only changes to this field.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organization_ref",
            "in": "query",
            "description": "Only this organization's entries.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "From this time (inclusive).",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Up to this time (exclusive).",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "`jsonl` (default) | `cef` | `csv`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Streamed export body (jsonl/cef/csv per `format`)"
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the required privilege",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-audit": {
          "events": [
            {
              "category": "security",
              "operation": "download"
            }
          ],
          "policy": "mandatory"
        },
        "x-cache": "no-store",
        "x-idempotent": "natural",
        "x-module": "audit",
        "x-privilege": "admin",
        "x-rate-class": "api",
        "x-risk": "low"
      }
    },
