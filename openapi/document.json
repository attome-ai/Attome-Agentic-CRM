{
  "openapi": "3.1.0",
  "info": {
    "title": "Attome XRM API",
    "description": "The Attome XRM platform's HTTP API. Entity record shapes under `/api/v1/{entity}` are resolved from each deployment's runtime metadata (D-003) and therefore cannot be enumerated statically — those operations document the generic envelope only. Fetch `GET /api/v1/schema/{logicalname}` for a live entity's fields.",
    "contact": {
      "name": "Automatica Tech Solutions"
    },
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "x-api-version": "2026-10",
  "paths": {
    "/api/v1/documents/folders": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Create a document folder",
        "description": "A named folder on one record for its documents. Audited.",
        "operationId": "create_folder",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFolderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Folder saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedFolder"
                }
              }
            }
          },
          "400": {
            "description": "Invalid folder path",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the required privilege",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-audit": {
          "events": [
            {
              "category": "business_event",
              "operation": "create"
            }
          ],
          "policy": "entity_policy"
        },
        "x-cache": "no-store",
        "x-idempotent": "key",
        "x-module": "document",
        "x-privilege": "authenticated",
        "x-rate-class": "api",
        "x-risk": "medium"
      }
    },
    "/api/v1/documents/tree": {
      "get": {
        "tags": [
          "documents"
        ],
        "summary": "Browse documents",
        "description": "The documents the caller may read, grouped by entity, record and folder with counts, for the\ndocuments browser.",
        "operationId": "get_tree",
        "parameters": [
          {
            "name": "entity_name",
            "in": "query",
            "description": "Only this entity (its logical name).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "record_id",
            "in": "query",
            "description": "Only this record.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "folder",
            "in": "query",
            "description": "The folder to list; the root when absent.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TreeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the required privilege",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-cache": "private-revalidate",
        "x-idempotent": "natural",
        "x-module": "document",
        "x-privilege": "authenticated",
        "x-rate-class": "api",
        "x-risk": "low"
      }
    },
    "/api/v1/esign/envelopes": {
      "post": {
        "tags": [
          "document"
        ],
        "summary": "Create a signature envelope",
        "description": "A draft envelope with documents the caller may read and its signers (name, email, role, signing\norder); each file is hashed now, so the certificate names exactly what was signed. Audited.",
        "operationId": "post_esign_envelope",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewEnvelope"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The draft envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeCreated"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "A document the caller may not read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "A bad title, document, signer or file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-audit": {
          "events": [
            {
              "category": "business_event",
              "operation": "create"
            }
          ],
          "policy": "entity_policy"
        },
        "x-cache": "no-store",
        "x-idempotent": "key",
        "x-module": "document",
        "x-privilege": "authenticated",
        "x-rate-class": "api",
        "x-risk": "medium"
      }
    },
    "/api/v1/esign/envelopes/{id}": {
      "get": {
        "tags": [
          "document"
        ],
        "summary": "Get a signature envelope",
        "description": "The envelope with its documents, signers and where each signer is.",
        "operationId": "get_esign_envelope",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The envelope",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The envelope, its signers, events and certificate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeView"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No envelope of the caller's",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-cache": "private-revalidate",
        "x-idempotent": "natural",
        "x-module": "document",
        "x-privilege": "authenticated",
        "x-rate-class": "api",
        "x-risk": "low"
      }
    },
    "/api/v1/esign/envelopes/{id}/send": {
      "post": {
        "tags": [
          "document"
        ],
        "summary": "Send a signature envelope",
        "description": "Emails the first signers in order a personal link; when everyone at one position has signed, the\nnext position is emailed. Audited.",
        "operationId": "post_esign_envelope_send",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The envelope",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Sent; the first signers are emailed"
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No envelope of the caller's",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Not a draft",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-audit": {
          "events": [
            {
              "category": "business_event",
              "operation": "update"
            }
          ],
          "policy": "entity_policy"
        },
        "x-cache": "no-store",
        "x-idempotent": "key",
        "x-module": "document",
        "x-privilege": "authenticated",
        "x-rate-class": "api",
        "x-risk": "medium"
      }
    },
    "/api/v1/esign/envelopes/{id}/void": {
      "post": {
        "tags": [
          "document"
        ],
        "summary": "Void a signature envelope",
        "description": "Stops the envelope; its links no longer work. Audited.",
        "operationId": "post_esign_envelope_void",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The envelope",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Voided; its links stop working"
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No envelope of the caller's",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Already finished",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          },
          {
            "api_key": []
          }
        ],
        "x-audit": {
          "events": [
            {
              "category": "business_event",
              "operation": "update"
            }
          ],
          "policy": "entity_policy"
        },
        "x-cache": "no-store",
        "x-idempotent": "key",
        "x-module": "document",
        "x-privilege": "authenticated",
        "x-rate-class": "api",
        "x-risk": "medium"
      }
    },
    "/api/v1/esign/sign/{token}": {
      "get": {
        "tags": [
          "document"
        ],
        "summary": "Open a signing link",
        "description": "What the signer is asked to sign. No session; the link's signed token is the credential.",
        "operationId": "get_esign_signer_view",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "description": "The signer's link token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "What the signer signs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignerView"
                }
              }
            }
          },
          "404": {
            "description": "An unknown, expired or voided link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {}
        ],
        "x-cache": "no-store",
        "x-idempotent": "natural",
        "x-module": "document",
        "x-privilege": "public",
        "x-rate-class": "api",
        "x-risk": "low"
      },
      "post": {
        "tags": [
          "document"
        ],
        "summary": "Act on a signing link",
        "description": "The signer asks for a code, signs or declines. No session: the link and the emailed code are the\ncredential.",
        "operationId": "post_esign_signer_action",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "description": "The signer's link token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignerAction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Done",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignerActionDone"
                }
              }
            }
          },
          "404": {
            "description": "An unknown, expired or voided link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Not this signer's turn, or a code was sent less than a minute ago",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "A wrong code, or no typed name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {}
        ],
        "x-audit": {
          "events": [
            {
              "category": "business_event",
              "operation": "update"
            }
          ],
          "policy": "entity_policy"
        },
        "x-cache": "no-store",
        "x-idempotent": "key",
        "x-module": "document",
        "x-privilege": "public",
        "x-rate-class": "api",
        "x-risk": "medium"
      }
    }
  },
  "components": {
    "schemas": {
      "CreateFolderRequest": {
        "type": "object",
        "required": [
          "entity_name",
          "record_id",
          "folder"
        ],
        "properties": {
          "entity_name": {
            "type": "string"
          },
          "folder": {
            "type": "string"
          },
          "record_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreatedFolder": {
        "type": "object",
        "required": [
          "id",
          "folder"
        ],
        "properties": {
          "folder": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "DocumentFile": {
        "type": "object",
        "required": [
          "id",
          "name",
          "row_version"
        ],
        "properties": {
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Some pre-provisioned `attome_document` tables predate the standard\n`created_at` system column. Keep the tree endpoint usable for those\ntables; the UI renders an unavailable date as `--`."
          },
          "file": {
            "type": [
              "string",
              "null"
            ],
            "description": "`NULL` for a row whose two-phase create (empty row -> upload session\n-> PATCH the key on, see the Angular component's doc comment) never\nreached the PATCH — an abandoned or failed upload. Decoding this as a\nplain `String` used to panic on exactly that row and abort the whole\nconnection (D-36x follow-up), taking every other document in the\nfolder down with it. The UI renders a `null` file as a failed row the\ncaller can still select and delete."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "modified_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "name": {
            "type": "string"
          },
          "row_version": {
            "type": "integer",
            "format": "int64"
          },
          "size_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "source_field": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "EntityGroup": {
        "type": "object",
        "required": [
          "entity_name",
          "display_name",
          "document_count"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "document_count": {
            "type": "integer",
            "format": "int64"
          },
          "entity_name": {
            "type": "string"
          }
        }
      },
      "EnvelopeCreated": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "EnvelopeDocument": {
        "type": "object",
        "description": "A document in an envelope.",
        "required": [
          "document_id",
          "name",
          "sha256"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      },
      "EnvelopeEvent": {
        "type": "object",
        "description": "One stored event.",
        "required": [
          "seq",
          "kind",
          "at",
          "detail",
          "prev_hash",
          "hash"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "detail": {
            "type": "object"
          },
          "hash": {
            "type": "string"
          },
          "ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string"
          },
          "prev_hash": {
            "type": "string"
          },
          "seq": {
            "type": "integer",
            "format": "int32"
          },
          "signer_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "EnvelopeSigner": {
        "type": "object",
        "description": "A signer, as the envelope's owner sees them.",
        "required": [
          "id",
          "name",
          "email",
          "role",
          "sign_order",
          "status"
        ],
        "properties": {
          "decline_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "sign_order": {
            "type": "integer",
            "format": "int32"
          },
          "signed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "typed_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "user_agent": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "EnvelopeView": {
        "type": "object",
        "description": "An envelope, as its owner sees it.",
        "required": [
          "id",
          "title",
          "status",
          "created_at",
          "documents",
          "signers",
          "events",
          "chain_intact"
        ],
        "properties": {
          "certificate": {
            "type": [
              "object",
              "null"
            ]
          },
          "certificate_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "chain_intact": {
            "type": "boolean",
            "description": "The events form an unbroken hash chain."
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnvelopeDocument"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnvelopeEvent"
            }
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sent_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "signers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnvelopeSigner"
            }
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "ErrorDetails": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          {
            "$ref": "#/components/schemas/RuleViolationDetails"
          },
          {
            "$ref": "#/components/schemas/FieldLockedDetails"
          }
        ],
        "description": "`ErrorResponse.details`: its shape depends on the `error` code —\na list of [`FieldError`] on `validation_error`, [`RuleViolationDetails`] on\n`rule_violation`, [`FieldLockedDetails`] on `field_locked` and\n`field_locked_required` (D-789)."
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error envelope. `error` is a stable machine-readable code; `message` is human-readable and never contains internal detail.",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ],
            "description": "The same value as `error`."
          },
          "current_state": {
            "description": "Present on a version conflict: the server's current row for the\nfields the caller touched, as a JSON object. The owning engine filters\nsensitive columns out before building it (BTY-16c's precondition), so\nthis is a deliberate filtered projection — never a raw row dump."
          },
          "current_version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Present on a version conflict: the `row_version` the server currently\nholds, so a caller can re-read and retry instead of guessing what the\nwinner wrote. Omitted when the conflict is not version-based."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "The same text as `message`."
          },
          "details": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ErrorDetails",
                "description": "Structured detail, shaped by `error` (see [`ErrorDetails`]): every\nfield-level failure on a `validation_error` response when the raiser\nhas a field list, so a form can render them all at once; every firing\nrule on a `rule_violation` response from a business rule; every\nrefused field on `field_locked` / `field_locked_required`. Omitted\notherwise."
              }
            ]
          },
          "effect": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present on `field_locked` / `field_locked_required`: `hidden` or\n`disabled`."
          },
          "error": {
            "type": "string",
            "description": "Stable machine-readable code — `not_found`, `unauthorized`, `forbidden`,\n`attribute_not_writable`, `limit_exceeded`,\n`conflict`, `version_conflict`, `duplicate_detected`, `idempotency_conflict`,\n`validation_error`, `customer_tests_failed`, `feature_unavailable`, `feature_hidden`,\n`rate_limit_exceeded`, `overloaded`, `capability_unavailable`,\n`metadata_authoring_locked`, `transition_not_allowed`,\n`rule_violation`, `field_locked`, `field_locked_required`,\n`reauth_required`, `server_timeout`, `query_timeout`, `read_only`, `payload_too_large`,\n`request_rejected`, `invalid_cursor`, `resync_needed`, `cascade_restricted`,\n`idempotency_outcome_unknown`, `idempotency_replay_unavailable`,\n`method_not_allowed`, or\n`internal_error` — one per `AppError` variant (`FieldLocked` answers\ntwo: plain and required) (`attome-types/src/error.rs`); M01 Core C-23\nfound this list four codes short of the taxonomy it documents."
          },
          "errors": {
            "type": [
              "array",
              "null"
            ],
            "items": {},
            "description": "Every field-level failure on a `validation_error`, as\n`{attribute, rule, message, fix}`."
          },
          "field": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present on `field_locked` / `field_locked_required` (D-789): the first\nrefused field (every one is in `details.fields`); on\n`attribute_not_writable` (Q15-T4): the attribute the caller may not\nwrite."
          },
          "hidden": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Present on `duplicate_detected`: how many more matches the caller may\nnot read."
          },
          "instance": {
            "type": [
              "string",
              "null"
            ],
            "description": "The request path the problem happened at."
          },
          "matches": {
            "description": "Present on `duplicate_detected` (A15-T4): the existing records the\nsave matches that the caller may read (record, rule, score)."
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present on responses that passed through the request-id middleware\n(D-043); absent on the few pre-middleware rejection paths."
          },
          "retry_after_sec": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Present on a `rate_limit_exceeded` response when the limiter knows its\nwindow: seconds to wait before retrying, equal by construction to the\n`Retry-After` header on the same response (BTY-11a). Omitted when the\nlimit that was hit has no known window.",
            "minimum": 0
          },
          "retryable": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the same request may succeed later (the error catalogue's\nverdict for `code`)."
          },
          "rule_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Present on a `rule_violation` response (D-472): the id of the\n`xrm_core_rule` whose failing expression produced this 422, so a\nclient can highlight or re-check the exact rule without parsing\n`message`. Omitted on every other code, and on any response that\ndoes not name a rule.\nAlso present on `field_locked` / `field_locked_required` (D-789): the\nbusiness rule that locks `field`."
          },
          "rule_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present on `field_locked` / `field_locked_required`: the display name\nof the rule that locks `field`."
          },
          "status": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "The HTTP status code.",
            "minimum": 0
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "A short title for `code` in the request's language (Z14-T3), e.g.\n`The resource was not found.`"
          },
          "type": {
            "type": [
              "string",
              "null"
            ],
            "description": "Z14-T1 (RFC 9457): `about:blank`; the problem is named by `code`."
          }
        },
        "example": {
          "error": "validation_error",
          "message": "validation error: name is required",
          "request_id": "018f0a1b-2c3d-7e4f-8a9b-0c1d2e3f4a5b"
        }
      },
      "FieldError": {
        "type": "object",
        "description": "One field-level failure inside `ErrorResponse.details` (BTY-16b): the\nfield the caller sent, a stable machine-readable `code` the client maps\nto localized text (e.g. `required`, `too_long`, `invalid_format`,\n`not_allowed`), and the English server-side `message`.\n\nA list, not a single error, so one 422 can answer with every bad field at\nonce (BTY-F11) instead of making a form discover them one round-trip at a\ntime.",
        "required": [
          "field",
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable failure code for this field, independent of\nthe message text."
          },
          "field": {
            "type": "string",
            "description": "The offending field, as the caller addressed it (e.g. `email` or\n`amount`)."
          },
          "message": {
            "type": "string",
            "description": "Human-readable, English, server-side detail for this field."
          }
        }
      },
      "FieldLockedDetails": {
        "type": "object",
        "description": "`details` of a `field_locked` / `field_locked_required` response: every\nrefused field, the first being the one the top-level `field` names.",
        "required": [
          "fields"
        ],
        "properties": {
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LockedField"
            }
          }
        }
      },
      "FolderGroup": {
        "type": "object",
        "required": [
          "folder",
          "document_count"
        ],
        "properties": {
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "A folder is a virtual grouping, not a single row, so this is the\nearliest timestamp among everything that makes the folder exist: the\nexplicit `document_folder.created_at` if it was created\nempty, and/or the earliest `created_at` of any document living under\nit. `NULL` only when the folder path predates the standard\n`created_at` column on some pre-provisioned tables."
          },
          "document_count": {
            "type": "integer",
            "format": "int64"
          },
          "folder": {
            "type": "string",
            "description": "Full path from the record's root, e.g. `uploads/Contracts` — pass\nstraight back as the next request's `folder` param to drill in."
          }
        }
      },
      "LockedField": {
        "type": "object",
        "description": "One field a business rule locks for the writer (D-789 §3.5): `effect` is\n`hidden` or `disabled`. No value is ever echoed.",
        "required": [
          "field",
          "rule_id",
          "rule_name",
          "effect"
        ],
        "properties": {
          "effect": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "rule_id": {
            "type": "string",
            "format": "uuid"
          },
          "rule_name": {
            "type": "string"
          }
        }
      },
      "NewEnvelope": {
        "type": "object",
        "description": "A new envelope.",
        "required": [
          "title",
          "document_ids",
          "signers"
        ],
        "properties": {
          "document_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "`attome_document` records the caller may read."
          },
          "signers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NewSigner"
            }
          },
          "title": {
            "type": "string"
          }
        }
      },
      "NewSigner": {
        "type": "object",
        "description": "A signer to add.",
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "order": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Signing position, 1 first; equal positions sign in any order."
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "description": "`signer` (the default), `approver` or `witness`."
          }
        }
      },
      "RecordGroup": {
        "type": "object",
        "required": [
          "record_id",
          "display_name",
          "document_count"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "document_count": {
            "type": "integer",
            "format": "int64"
          },
          "record_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "RuleFailure": {
        "type": "object",
        "description": "One business-rule `error` policy that fired (D-789 §3.3), inside a\n`rule_violation` body's `details.rules`. Carries names and the rule's own\nmessage, never a record value.",
        "required": [
          "rule_id",
          "rule_name",
          "message"
        ],
        "properties": {
          "field": {
            "type": [
              "string",
              "null"
            ],
            "description": "The field the policy is attached to, when it names one."
          },
          "message": {
            "type": "string"
          },
          "rule_id": {
            "type": "string",
            "format": "uuid"
          },
          "rule_name": {
            "type": "string",
            "description": "The rule's display name (its name when it has none)."
          }
        }
      },
      "RuleViolationDetails": {
        "type": "object",
        "description": "`details` of a `rule_violation` response (D-789): the field of the first\nfailing policy, when it names one, and every blocking `error` policy that\nfired, the first (by rule display order) being the one `rule_id` names.",
        "required": [
          "rules"
        ],
        "properties": {
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RuleFailure"
            }
          }
        }
      },
      "SignerAction": {
        "type": "object",
        "description": "A signer's action.",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "`code` (email me a code), `sign` or `decline`."
          },
          "code": {
            "type": [
              "string",
              "null"
            ],
            "description": "The emailed code, to sign or decline."
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why, to decline."
          },
          "typed_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The signer's name as they type it, to sign."
          }
        }
      },
      "SignerActionDone": {
        "type": "object",
        "description": "What a signer's action did.",
        "required": [
          "result",
          "envelope_status"
        ],
        "properties": {
          "envelope_status": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "description": "`code_sent`, `signed` or `declined`."
          }
        }
      },
      "SignerView": {
        "type": "object",
        "description": "What a signer sees.",
        "required": [
          "envelope_title",
          "envelope_status",
          "signer_name",
          "signer_status",
          "may_sign",
          "documents"
        ],
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnvelopeDocument"
            }
          },
          "envelope_status": {
            "type": "string"
          },
          "envelope_title": {
            "type": "string"
          },
          "may_sign": {
            "type": "boolean",
            "description": "It is this signer's turn."
          },
          "signer_name": {
            "type": "string"
          },
          "signer_status": {
            "type": "string"
          }
        }
      },
      "TreeResponse": {
        "type": "object",
        "required": [
          "entities",
          "records",
          "folders",
          "files"
        ],
        "properties": {
          "entities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityGroup"
            },
            "description": "Populated only at the root (no query params)."
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentFile"
            },
            "description": "Files whose `folder` matches exactly — only when `folder` is given\n(there is no such thing as a folder-less document, so this is always\nempty at the record level without a `folder` param)."
          },
          "folders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FolderGroup"
            },
            "description": "Populated once `entity_name` + `record_id` are both given — the\nsubfolders directly under `folder` (root of the record's document\nspace when `folder` is omitted)."
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecordGroup"
            },
            "description": "Populated only when `entity_name` is given without `record_id`."
          }
        }
      }
    },
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "`Authorization: ApiKey <public_key>:<secret>`, issued by POST /api/v1/auth/api-keys."
      },
      "portal_session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-wp_{portal}_session",
        "description": "A web portal user's session cookie, issued by the portal's sign-in; `{portal}` is the portal's keyword (`wp_{portal}_session` on plain-http local dev). Valid only on that portal's own routes."
      },
      "s2s_hmac": {
        "type": "apiKey",
        "in": "header",
        "name": "x-s2s-signature",
        "description": "A system-to-system call, signed. Send `x-s2s-client-id`, `x-s2s-key-id`, `x-s2s-timestamp` (Unix milliseconds, within 300 seconds of the server's clock), `x-s2s-nonce` (single use: a repeat is refused) and `x-s2s-signature`: the hex HMAC-SHA256, keyed by the hex-decoded client secret, of `METHOD`, `PATH_AND_QUERY`, the hex SHA-256 of the body, `TIMESTAMP` and `NONCE`, joined by newlines in that order."
      },
      "session_cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-session_token",
        "description": "Browser session cookie issued by POST /api/v1/auth/login. Mutating requests additionally require the CSRF conditions enforced by `middleware::csrf`."
      }
    }
  },
  "tags": []
}
