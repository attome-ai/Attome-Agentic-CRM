    { "entity": "service_catalog", "name": "Active Service Catalogs", "sql": "SELECT id FROM service_catalog WHERE is_active = true", "required_privilege": "service_catalog.read" },
    { "entity": "service_category", "name": "Active Service Categories", "sql": "SELECT id FROM service_category WHERE is_active = true", "required_privilege": "service_category.read" },
    { "entity": "service_offering_version", "name": "Active Offering Versions", "sql": "SELECT id FROM service_offering_version WHERE is_active = true", "required_privilege": "service_offering_version.read" },
    { "entity": "service_request_item", "name": "Active Request Items", "sql": "SELECT id FROM service_request_item WHERE is_active = true", "required_privilege": "service_request_item.read" },
