  "queries": [
    { "entity": "service_work_request", "name": "Active Work Requests", "sql": "SELECT id FROM service_work_request WHERE is_active = true", "required_privilege": "service_work_request.read" },
    { "entity": "service_work_request", "name": "Inactive Work Requests", "sql": "SELECT id FROM service_work_request WHERE is_active = false", "required_privilege": "service_work_request.read" },
    { "entity": "service_sla_policy", "name": "Active SLA Policys", "sql": "SELECT id FROM service_sla_policy WHERE is_active = true", "required_privilege": "service_sla_policy.read" },
    { "entity": "service_sla_policy", "name": "Inactive SLA Policys", "sql": "SELECT id FROM service_sla_policy WHERE is_active = false", "required_privilege": "service_sla_policy.read" },
    { "entity": "service_ticket", "name": "Active Tickets", "sql": "SELECT id, ticket_number, title, status, priority, assignee_id, resolution_due_at, resolved_at, sla_policy_id, sla_breached, sla_warned, sla_calculation_status, sla_unresolved_reason FROM service_ticket WHERE is_active = true", "required_privilege": "service_ticket.read" },
    { "entity": "service_ticket", "name": "Inactive Tickets", "sql": "SELECT id, ticket_number, title, status, priority, assignee_id, resolution_due_at, resolved_at, sla_policy_id, sla_breached, sla_warned, sla_calculation_status, sla_unresolved_reason FROM service_ticket WHERE is_active = false", "required_privilege": "service_ticket.read" },
    { "entity": "service_offering", "name": "Active Service Offerings", "sql": "SELECT id FROM service_offering WHERE is_active = true", "required_privilege": "service_offering.read" },
    { "entity": "service_offering", "name": "Inactive Service Offerings", "sql": "SELECT id FROM service_offering WHERE is_active = false", "required_privilege": "service_offering.read" },
    { "entity": "service_sla_clock", "name": "Active SLA Clocks", "sql": "SELECT id FROM service_sla_clock WHERE is_active = true", "required_privilege": "service_sla_clock.read" },
    { "entity": "service_sla_clock", "name": "Inactive SLA Clocks", "sql": "SELECT id FROM service_sla_clock WHERE is_active = false", "required_privilege": "service_sla_clock.read" },
