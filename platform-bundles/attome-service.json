    { "entity": "service_sla_calculation", "name": "Inactive SLA Calculations", "sql": "SELECT id FROM service_sla_calculation WHERE is_active = false", "required_privilege": "service_sla_calculation.read" },
    { "entity": "service_work_queue", "name": "Active Work Queues", "sql": "SELECT id FROM service_work_queue WHERE is_active = true", "required_privilege": "service_work_queue.read" },
    { "entity": "service_work_queue", "name": "Inactive Work Queues", "sql": "SELECT id FROM service_work_queue WHERE is_active = false", "required_privilege": "service_work_queue.read" },
    { "entity": "service_work_queue_member", "name": "Active Work Queue Members", "sql": "SELECT id FROM service_work_queue_member WHERE is_active = true", "required_privilege": "service_work_queue_member.read" },
    { "entity": "service_work_queue_member", "name": "Inactive Work Queue Members", "sql": "SELECT id FROM service_work_queue_member WHERE is_active = false", "required_privilege": "service_work_queue_member.read" },
    { "entity": "service_ticket", "name": "SLA Attainment % (Last 30 Days)", "sql": "SELECT (COUNT(*) FILTER (WHERE sla_breached IS NOT TRUE))::float8 / NULLIF(COUNT(*), 0) * 100 AS value FROM service_ticket WHERE (is_active IS NULL OR is_active = true) AND sla_policy_id IS NOT NULL AND (sla_calculation_status IS NULL OR sla_calculation_status <> 'unresolved') AND status IN ('resolved', 'closed') AND resolved_at IS NOT NULL AND resolved_at >= NOW() - INTERVAL '30 days'", "required_privilege": "service_ticket.read", "is_report": true },
    { "entity": "service_ticket", "name": "SLA Mean Time To Resolve, Minutes (Last 30 Days)", "sql": "SELECT AVG(EXTRACT(EPOCH FROM (resolved_at - created_at)) / 60.0) AS value FROM service_ticket WHERE (is_active IS NULL OR is_active = true) AND status IN ('resolved', 'closed') AND resolved_at IS NOT NULL AND resolved_at >= NOW() - INTERVAL '30 days'", "required_privilege": "service_ticket.read", "is_report": true },
    { "entity": "service_ticket", "name": "SLA Breaches By Queue And Priority", "sql": "SELECT queue_id, priority, COUNT(*) AS breach_count FROM service_ticket WHERE (is_active IS NULL OR is_active = true) AND sla_breached = true GROUP BY queue_id, priority", "required_privilege": "service_ticket.read", "is_report": true },
    { "entity": "service_work_queue", "name": "Queue Depth (Open, Unassigned Items Per Queue)", "sql": "SELECT work_queue_ref AS queue_ref, COUNT(*) AS value FROM service_ticket WHERE (is_active IS NULL OR is_active = true) AND work_queue_ref IS NOT NULL AND assignee_id IS NULL AND status NOT IN ('resolved', 'closed') GROUP BY work_queue_ref", "required_privilege": "service_work_queue.read", "is_report": true },
    { "entity": "service_work_queue", "name": "Queue Average Wait, Minutes (Currently Unassigned Items)", "sql": "SELECT work_queue_ref AS queue_ref, AVG(EXTRACT(EPOCH FROM (NOW() - created_at)) / 60.0) AS value FROM service_ticket WHERE (is_active IS NULL OR is_active = true) AND work_queue_ref IS NOT NULL AND assignee_id IS NULL AND status NOT IN ('resolved', 'closed') GROUP BY work_queue_ref", "required_privilege": "service_work_queue.read", "is_report": true },
    { "entity": "service_ticket", "name": "Queue Claim-To-Resolve, Minutes (Last 30 Days)", "sql": "SELECT work_queue_ref AS queue_ref, AVG(EXTRACT(EPOCH FROM (resolved_at - claimed_at)) / 60.0) AS value FROM service_ticket WHERE (is_active IS NULL OR is_active = true) AND work_queue_ref IS NOT NULL AND status IN ('resolved', 'closed') AND resolved_at IS NOT NULL AND claimed_at IS NOT NULL AND resolved_at >= NOW() - INTERVAL '30 days'", "required_privilege": "service_ticket.read", "is_report": true },
    { "entity": "service_escalation_rule", "name": "Active Escalation Rules", "sql": "SELECT id FROM service_escalation_rule WHERE is_active = true", "required_privilege": "service_escalation_rule.read" },
