  "privileges": [
    { "key": "project_change_request.approve", "name": "project_change_request.approve", "description": "Approve or reject a project change request (M69 S3)" },
    { "key": "project_timesheet.approve", "name": "project_timesheet.approve", "description": "Approve or reject a submitted timesheet (M69 S3)" }
  ],
  "roles": [
    {
      "name": "Project Approver",
      "description": "Decides project change requests and timesheets: the approve privilege on both, plus the read and update access the decision routes need. Nobody can approve a change request they requested or a timesheet that is their own (transition guard).",
      "privileges": [
        { "privilege": "project_change_request.read" },
        { "privilege": "project_change_request.update" },
        { "privilege": "project_change_request.approve" },
        { "privilege": "project_timesheet.read" },
        { "privilege": "project_timesheet.update" },
        { "privilege": "project_timesheet.approve" }
      ],
      "entity_access": [],
      "field_security_profiles": []
    }
  ],
  "state_models": [
    {
      "entity_logicalname": "project_change_request",
      "name": "Change Request Decision",
      "state_field": "status",
      "initial_state": "pending",
      "transitions": [
        { "from_state": "pending", "to_state": "approved", "name": "approve", "display_order": 0, "required_privilege": "project_change_request.approve", "guard_expression": "current_user != requested_by" },
        { "from_state": "pending", "to_state": "rejected", "name": "reject", "display_order": 1, "required_privilege": "project_change_request.approve", "guard_expression": "current_user != requested_by" }
      ]
    },
    {
      "entity_logicalname": "project_timesheet",
      "name": "Timesheet Approval",
      "state_field": "status",
      "initial_state": "draft",
      "transitions": [
        { "from_state": "draft", "to_state": "submitted", "name": "submit", "display_order": 0 },
        { "from_state": "submitted", "to_state": "approved", "name": "approve", "display_order": 1, "required_privilege": "project_timesheet.approve", "guard_expression": "current_user != user_id" },
        { "from_state": "submitted", "to_state": "rejected", "name": "reject", "display_order": 2, "required_privilege": "project_timesheet.approve", "guard_expression": "current_user != user_id" },
        { "from_state": "rejected", "to_state": "draft", "name": "revise", "display_order": 3 }
      ]
    },
    {
      "entity_logicalname": "project_work_item",
      "name": "Work Item Lifecycle",
      "state_field": "status",
      "initial_state": "not_started",
      "transitions": [
        { "from_state": "not_started", "to_state": "in_progress", "name": "not_started_to_in_progress", "display_order": 0 },
        { "from_state": "not_started", "to_state": "done", "name": "not_started_to_done", "display_order": 1 },
        { "from_state": "not_started", "to_state": "blocked", "name": "not_started_to_blocked", "display_order": 2 },
        { "from_state": "in_progress", "to_state": "not_started", "name": "in_progress_to_not_started", "display_order": 3 },
        { "from_state": "in_progress", "to_state": "done", "name": "in_progress_to_done", "display_order": 4 },
        { "from_state": "in_progress", "to_state": "blocked", "name": "in_progress_to_blocked", "display_order": 5 },
        { "from_state": "done", "to_state": "not_started", "name": "done_to_not_started", "display_order": 6 },
        { "from_state": "done", "to_state": "in_progress", "name": "done_to_in_progress", "display_order": 7 },
        { "from_state": "done", "to_state": "blocked", "name": "done_to_blocked", "display_order": 8 },
        { "from_state": "blocked", "to_state": "not_started", "name": "blocked_to_not_started", "display_order": 9 },
        { "from_state": "blocked", "to_state": "in_progress", "name": "blocked_to_in_progress", "display_order": 10 },
        { "from_state": "blocked", "to_state": "done", "name": "blocked_to_done", "display_order": 11 }
      ]
    },
    {
      "entity_logicalname": "attome_project",
      "name": "Project Lifecycle",
      "state_field": "status",
      "initial_state": "planning",
      "transitions": [
        { "from_state": "planning", "to_state": "active", "name": "Start", "display_order": 0 },
        { "from_state": "planning", "to_state": "on_hold", "name": "Put On Hold", "display_order": 1 },
        { "from_state": "planning", "to_state": "cancelled", "name": "Cancel", "display_order": 2 },
        { "from_state": "active", "to_state": "on_hold", "name": "Put On Hold", "display_order": 3 },
        { "from_state": "active", "to_state": "completed", "name": "Complete", "display_order": 4 },
        { "from_state": "active", "to_state": "cancelled", "name": "Cancel", "display_order": 5 },
        { "from_state": "on_hold", "to_state": "active", "name": "Resume", "display_order": 6 },
        { "from_state": "on_hold", "to_state": "planning", "name": "Back To Planning", "display_order": 7 },
        { "from_state": "on_hold", "to_state": "cancelled", "name": "Cancel", "display_order": 8 },
        { "from_state": "completed", "to_state": "active", "name": "Reopen", "display_order": 9 },
        { "from_state": "cancelled", "to_state": "planning", "name": "Reinstate", "display_order": 10 }
      ]
    },
    {
      "entity_logicalname": "project_issue",
      "name": "Issue Lifecycle",
      "state_field": "status",
      "initial_state": "open",
      "transitions": [
        { "from_state": "open", "to_state": "mitigating", "name": "Start Mitigation", "display_order": 0 },
        { "from_state": "open", "to_state": "resolved", "name": "Resolve", "display_order": 1 },
        { "from_state": "open", "to_state": "closed", "name": "Close", "display_order": 2 },
        { "from_state": "mitigating", "to_state": "open", "name": "Stop Mitigation", "display_order": 3 },
        { "from_state": "mitigating", "to_state": "resolved", "name": "Resolve", "display_order": 4 },
        { "from_state": "mitigating", "to_state": "closed", "name": "Close", "display_order": 5 },
        { "from_state": "resolved", "to_state": "closed", "name": "Close", "display_order": 6 },
        { "from_state": "resolved", "to_state": "open", "name": "Reopen", "display_order": 7 },
        { "from_state": "closed", "to_state": "open", "name": "Reopen", "display_order": 8 }
      ]
    },
    {
      "entity_logicalname": "project_deliverable",
      "name": "Deliverable Lifecycle",
      "state_field": "status",
      "initial_state": "draft",
      "transitions": [
        { "from_state": "draft", "to_state": "submitted", "name": "Submit", "display_order": 0 },
        { "from_state": "submitted", "to_state": "accepted", "name": "Accept", "display_order": 1 },
        { "from_state": "submitted", "to_state": "rejected", "name": "Reject", "display_order": 2 },
        { "from_state": "submitted", "to_state": "draft", "name": "Withdraw", "display_order": 3 },
        { "from_state": "rejected", "to_state": "draft", "name": "Rework", "display_order": 4 }
      ]
    }
  ]
}
