{
  "format": "attome-bundle/v1",
  "requires": {
    "platform_version": ">=0.1.0",
    "schema_version": 1,
    "modules": ["core"]
  },
  "entities": [
    {
      "logicalname": "license",
      "display_name": "License",
      "primary_name_attribute": "domain",
      "is_append_only": true,
      "attributes": [
        { "logicalname": "deployment_id", "display_name": "Deployment ID", "field_type": "text", "is_required": true },
        { "logicalname": "domain", "display_name": "Domain", "field_type": "text", "is_required": true },
        { "logicalname": "tier", "display_name": "Tier", "field_type": "text", "is_required": true },
        { "logicalname": "max_users", "display_name": "Max Users", "field_type": "number", "is_required": true },
        { "logicalname": "expiry", "display_name": "Expiry", "field_type": "date_time", "is_required": true },
        { "logicalname": "modules", "display_name": "Modules", "field_type": "text" },
        { "logicalname": "issued_at", "display_name": "Issued At", "field_type": "date_time", "is_required": true },
        { "logicalname": "signature", "display_name": "Signature", "field_type": "text", "is_required": true, "is_sensitive": true },
        { "logicalname": "signing_key_id", "display_name": "Signing Key ID", "field_type": "text" }
      ]
    }
  ],
  "queries": [
    {
      "entity": "license",
      "name": "Licenses",
      "sql": "SELECT id, created_at, deployment_id, domain, tier, max_users, expiry, modules, issued_at FROM license",
      "required_privilege": "license.read"
    }
  ],
  "views": [
    {
      "entity": "license",
      "name": "Licenses",
      "query": { "entity": "license", "name": "Licenses" },
      "is_default": true
    }
  ]
}
