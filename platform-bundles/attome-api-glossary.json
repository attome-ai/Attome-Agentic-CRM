{
  "format": "attome-bundle/v1",
  "requires": {
    "platform_version": ">=0.1.0",
    "schema_version": 1,
    "modules": ["core"]
  },
  "entities": [
    {
      "logicalname": "glossary_term",
      "display_name": "Glossary Term",
      "primary_name_attribute": "term",
      "is_append_only": false,
      "attributes": [
        { "logicalname": "term", "display_name": "Term", "field_type": "text", "is_required": true, "is_sortable": true, "is_filterable": true },
        { "logicalname": "definition", "display_name": "Definition", "field_type": "text", "is_required": true },
        { "logicalname": "domain_ref", "display_name": "Data Domain", "field_type": "text", "is_filterable": true },
        { "logicalname": "synonyms", "display_name": "Synonyms", "field_type": "text" },
        { "logicalname": "status", "display_name": "Status", "field_type": "choice", "is_required": true, "is_sortable": true, "is_filterable": true, "options": { "choices": ["draft", "approved", "deprecated"], "multi": false } },
        { "logicalname": "primary_entity_logicalname", "display_name": "Primary Entity", "field_type": "text", "is_sortable": true, "is_filterable": true },
        { "logicalname": "primary_attribute_logicalname", "display_name": "Primary Attribute", "field_type": "text", "is_filterable": true }
      ]
    }
  ],
  "queries": [
    {
      "entity": "glossary_term",
      "name": "Active Glossary Terms",
      "sql": "SELECT id, term, definition, domain_ref, synonyms, status, primary_entity_logicalname, primary_attribute_logicalname, row_version, created_at, modified_at FROM glossary_term WHERE is_active IS NOT FALSE",
      "required_privilege": "glossary_term.read"
    }
  ],
  "views": [
    {
      "entity": "glossary_term",
      "name": "Active Glossary Terms",
      "query": { "entity": "glossary_term", "name": "Active Glossary Terms" },
      "is_default": true
    }
  ]
}
