{
  "format": "attome-bundle/v1",
  "requires": {
    "platform_version": ">=0.1.0",
    "schema_version": 1,
    "modules": ["core"]
  },
  "entities": [
    {
      "logicalname": "follow",
      "display_name": "Follow",
      "is_append_only": false,
      "attributes": [
        { "logicalname": "user_id", "display_name": "User", "field_type": "lookup", "is_required": true, "is_filterable": true, "lookup_entity": "user_account" },
        { "logicalname": "entity_name", "display_name": "Entity Name", "field_type": "text", "is_required": true, "is_filterable": true },
        { "logicalname": "record_id", "display_name": "Record Id", "field_type": "text", "is_required": true, "is_filterable": true }
      ]
    },
    {
      "logicalname": "feed_post",
      "display_name": "Feed Post",
      "is_append_only": false,
      "attributes": [
        { "logicalname": "body", "display_name": "Body", "field_type": "text", "is_required": true, "max_length": 4000 }
      ]
    }
  ],
  "queries": [
    {
      "entity": "follow",
      "name": "Active Follows",
      "sql": "SELECT id, user_id, entity_name, record_id, created_at FROM follow WHERE is_active IS NOT FALSE",
      "required_privilege": "follow.read"
    },
    {
      "entity": "feed_post",
      "name": "Active Posts",
      "sql": "SELECT id, body, created_at FROM feed_post WHERE is_active IS NOT FALSE",
      "required_privilege": "feed_post.read"
    }
  ],
  "views": [
    {
      "entity": "follow",
      "name": "Active Follows",
      "query": { "entity": "follow", "name": "Active Follows" },
      "is_default": true
    },
    {
      "entity": "feed_post",
      "name": "Active Posts",
      "query": { "entity": "feed_post", "name": "Active Posts" },
      "is_default": true
    }
  ]
}
