    { "entity": "attome_dashboard", "name": "Active Dashboards", "sql": "SELECT id, name, dashboard_type, lifecycle_status, visibility, owner_id, is_template FROM attome_dashboard WHERE is_active = true", "required_privilege": "attome_dashboard.read" },
