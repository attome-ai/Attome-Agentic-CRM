{
  "description_en": "Send expense claims above a limit for a second approval.",
  "description_ar": "يرسل مطالبات المصروفات التي تتجاوز حدًا معينًا لموافقة ثانية.",
  "parameters": [
    {
      "name": "entity",
      "type": "entity",
      "label_en": "Record type",
      "label_ar": "نوع السجل",
      "default": "expense_claim"
    },
    {
      "name": "amount",
      "type": "attribute",
      "label_en": "Amount field",
      "label_ar": "حقل المبلغ",
      "of": "entity",
      "default": "amount"
    },
    {
      "name": "limit",
      "type": "number",
      "label_en": "Limit",
      "label_ar": "الحد",
      "default": 1000
    }
  ],
  "graph": {
    "nodes": [
      {
        "id": "start",
        "type": "trigger",
        "config": {
          "trigger_type": "create",
          "entity_logicalname": "{{entity}}"
        }
      },
      {
        "id": "check",
        "type": "condition",
        "config": {
          "expression": "{{amount}} > {{limit}}"
        }
      },
      {
        "id": "approve",
        "type": "approval",
        "config": {
          "action_type": "workflow.approval",
          "ttl_hours": 72
        }
      }
    ],
    "edges": [
      {
        "from_node": "start",
        "from_port": "out",
        "to_node": "check",
        "to_port": "value"
      },
      {
        "from_node": "check",
        "from_port": "true",
        "to_node": "approve",
        "to_port": "payload"
      }
    ]
  }
}
