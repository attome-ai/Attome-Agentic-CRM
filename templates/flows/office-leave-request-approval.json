{
  "description_en": "Send every leave request to the manager and tell the person the answer.",
  "description_ar": "يرسل كل طلب إجازة إلى المدير ويبلغ صاحبه بالقرار.",
  "parameters": [
    {
      "name": "entity",
      "type": "entity",
      "label_en": "Record type",
      "label_ar": "نوع السجل",
      "default": "leave_request"
    },
    {
      "name": "template",
      "type": "text",
      "label_en": "Notification template key",
      "label_ar": "مفتاح قالب الإشعار",
      "default": "workflow.generic"
    }
  ],
  "graph": {
    "nodes": [
      {
        "id": "start",
        "type": "trigger",
        "config": {
          "trigger_type": "create",
          "entity_logicalname": "{{entity}}"
        }
      },
      {
        "id": "approve",
        "type": "approval",
        "config": {
          "action_type": "workflow.approval",
          "ttl_hours": 48
        }
      },
      {
        "id": "approved",
        "type": "send_notification",
        "config": {
          "template_key": "{{template}}"
        }
      },
      {
        "id": "rejected",
        "type": "send_notification",
        "config": {
          "template_key": "{{template}}"
        }
      }
    ],
    "edges": [
      {
        "from_node": "start",
        "from_port": "out",
        "to_node": "approve",
        "to_port": "payload"
      },
      {
        "from_node": "approve",
        "from_port": "approved",
        "to_node": "approved",
        "to_port": "variables"
      },
      {
        "from_node": "approve",
        "from_port": "rejected",
        "to_node": "rejected",
        "to_port": "variables"
      }
    ]
  }
}
