{
  "description_en": "Send a deal above an amount for approval before it moves on.",
  "description_ar": "يرسل الصفقة التي تتجاوز مبلغًا محددًا للموافقة قبل أن تتقدم.",
  "parameters": [
    {
      "name": "entity",
      "type": "entity",
      "label_en": "Record type",
      "label_ar": "نوع السجل",
      "default": "opportunity"
    },
    {
      "name": "amount",
      "type": "attribute",
      "label_en": "Amount field",
      "label_ar": "حقل المبلغ",
      "of": "entity",
      "default": "amount"
    },
    {
      "name": "threshold",
      "type": "number",
      "label_en": "Amount that needs approval",
      "label_ar": "المبلغ الذي يحتاج إلى موافقة",
      "default": 100000
    }
  ],
  "graph": {
    "nodes": [
      {
        "id": "start",
        "type": "trigger",
        "config": {
          "trigger_type": "update",
          "entity_logicalname": "{{entity}}"
        }
      },
      {
        "id": "check",
        "type": "condition",
        "config": {
          "expression": "{{amount}} > {{threshold}}"
        }
      },
      {
        "id": "approve",
        "type": "approval",
        "config": {
          "action_type": "workflow.approval",
          "ttl_hours": 72
        }
      }
    ],
    "edges": [
      {
        "from_node": "start",
        "from_port": "out",
        "to_node": "check",
        "to_port": "value"
      },
      {
        "from_node": "check",
        "from_port": "true",
        "to_node": "approve",
        "to_port": "payload"
      }
    ]
  }
}
