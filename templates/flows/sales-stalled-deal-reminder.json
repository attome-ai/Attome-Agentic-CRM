{
  "description_en": "Remind the owner when a deal has not moved for a week.",
  "description_ar": "يذكّر المالك عندما لا تتقدم الصفقة لمدة أسبوع.",
  "parameters": [
    {
      "name": "entity",
      "type": "entity",
      "label_en": "Record type",
      "label_ar": "نوع السجل",
      "default": "opportunity"
    },
    {
      "name": "template",
      "type": "text",
      "label_en": "Notification template key",
      "label_ar": "مفتاح قالب الإشعار",
      "default": "workflow.generic"
    }
  ],
  "graph": {
    "nodes": [
      {
        "id": "start",
        "type": "trigger",
        "config": {
          "trigger_type": "update",
          "entity_logicalname": "{{entity}}"
        }
      },
      {
        "id": "wait",
        "type": "wait",
        "config": {
          "delay_seconds": 604800
        }
      },
      {
        "id": "remind",
        "type": "send_notification",
        "config": {
          "template_key": "{{template}}"
        }
      }
    ],
    "edges": [
      {
        "from_node": "start",
        "from_port": "out",
        "to_node": "wait",
        "to_port": "in"
      },
      {
        "from_node": "wait",
        "from_port": "out",
        "to_node": "remind",
        "to_port": "variables"
      }
    ]
  }
}
