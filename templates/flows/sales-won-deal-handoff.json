{
  "description_en": "Tell finance and delivery when a deal is won.",
  "description_ar": "يبلغ المالية والتنفيذ عند كسب الصفقة.",
  "parameters": [
    {
      "name": "entity",
      "type": "entity",
      "label_en": "Record type",
      "label_ar": "نوع السجل",
      "default": "opportunity"
    },
    {
      "name": "stage",
      "type": "attribute",
      "label_en": "Stage field",
      "label_ar": "حقل المرحلة",
      "of": "entity",
      "default": "stage"
    },
    {
      "name": "template",
      "type": "text",
      "label_en": "Notification template key",
      "label_ar": "مفتاح قالب الإشعار",
      "default": "workflow.generic"
    }
  ],
  "graph": {
    "nodes": [
      {
        "id": "start",
        "type": "trigger",
        "config": {
          "trigger_type": "update",
          "entity_logicalname": "{{entity}}"
        }
      },
      {
        "id": "won",
        "type": "condition",
        "config": {
          "expression": "{{stage}} == \"closed_won\""
        }
      },
      {
        "id": "tell",
        "type": "send_notification",
        "config": {
          "template_key": "{{template}}"
        }
      }
    ],
    "edges": [
      {
        "from_node": "start",
        "from_port": "out",
        "to_node": "won",
        "to_port": "value"
      },
      {
        "from_node": "won",
        "from_port": "true",
        "to_node": "tell",
        "to_port": "variables"
      }
    ]
  }
}
