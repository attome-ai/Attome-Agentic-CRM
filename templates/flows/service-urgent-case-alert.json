{
  "description_en": "Alert the on-duty team when an urgent case comes in.",
  "description_ar": "ينبّه الفريق المناوب عند ورود حالة عاجلة.",
  "parameters": [
    {
      "name": "entity",
      "type": "entity",
      "label_en": "Record type",
      "label_ar": "نوع السجل",
      "default": "case"
    },
    {
      "name": "priority",
      "type": "attribute",
      "label_en": "Priority field",
      "label_ar": "حقل الأولوية",
      "of": "entity",
      "default": "priority"
    },
    {
      "name": "template",
      "type": "text",
      "label_en": "Notification template key",
      "label_ar": "مفتاح قالب الإشعار",
      "default": "workflow.generic"
    }
  ],
  "graph": {
    "nodes": [
      {
        "id": "start",
        "type": "trigger",
        "config": {
          "trigger_type": "create",
          "entity_logicalname": "{{entity}}"
        }
      },
      {
        "id": "urgent",
        "type": "condition",
        "config": {
          "expression": "{{priority}} == \"urgent\""
        }
      },
      {
        "id": "alert",
        "type": "send_notification",
        "config": {
          "template_key": "{{template}}"
        }
      }
    ],
    "edges": [
      {
        "from_node": "start",
        "from_port": "out",
        "to_node": "urgent",
        "to_port": "value"
      },
      {
        "from_node": "urgent",
        "from_port": "true",
        "to_node": "alert",
        "to_port": "variables"
      }
    ]
  }
}
