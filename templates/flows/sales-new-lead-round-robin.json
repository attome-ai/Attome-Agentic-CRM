{
  "description_en": "Give every new lead to the next person of a team, in turn.",
  "description_ar": "يُسند كل عميل محتمل جديد إلى الشخص التالي في الفريق بالتناوب.",
  "parameters": [
    {
      "name": "entity",
      "type": "entity",
      "label_en": "Record type",
      "label_ar": "نوع السجل",
      "default": "lead"
    },
    {
      "name": "team",
      "type": "text",
      "label_en": "Team id",
      "label_ar": "معرّف الفريق",
      "default": "00000000-0000-7000-8000-000000000000"
    }
  ],
  "graph": {
    "nodes": [
      {
        "id": "start",
        "type": "trigger",
        "config": {
          "trigger_type": "create",
          "entity_logicalname": "{{entity}}"
        }
      },
      {
        "id": "assign",
        "type": "assign",
        "config": {
          "entity": "{{entity}}",
          "strategy": "round_robin",
          "team_ref": "{{team}}"
        }
      }
    ],
    "edges": [
      {
        "from_node": "start",
        "from_port": "out",
        "to_node": "assign",
        "to_port": "record_id"
      }
    ]
  }
}
