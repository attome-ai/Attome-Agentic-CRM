{
  "description_en": "Send a quote with a discount above a limit for a manager's approval.",
  "description_ar": "يرسل عرض السعر الذي يتجاوز خصمه حدًا معينًا لموافقة المدير.",
  "parameters": [
    {
      "name": "entity",
      "type": "entity",
      "label_en": "Record type",
      "label_ar": "نوع السجل",
      "default": "quote"
    },
    {
      "name": "discount",
      "type": "attribute",
      "label_en": "Discount field",
      "label_ar": "حقل الخصم",
      "of": "entity",
      "default": "discount_percent"
    },
    {
      "name": "limit",
      "type": "number",
      "label_en": "Highest discount without approval",
      "label_ar": "أعلى خصم بلا موافقة",
      "default": 15
    }
  ],
  "graph": {
    "nodes": [
      {
        "id": "start",
        "type": "trigger",
        "config": {
          "trigger_type": "update",
          "entity_logicalname": "{{entity}}"
        }
      },
      {
        "id": "check",
        "type": "condition",
        "config": {
          "expression": "{{discount}} > {{limit}}"
        }
      },
      {
        "id": "approve",
        "type": "approval",
        "config": {
          "action_type": "workflow.approval",
          "ttl_hours": 48
        }
      }
    ],
    "edges": [
      {
        "from_node": "start",
        "from_port": "out",
        "to_node": "check",
        "to_port": "value"
      },
      {
        "from_node": "check",
        "from_port": "true",
        "to_node": "approve",
        "to_port": "payload"
      }
    ]
  }
}
