# Config is loaded from config.json (production) or config.debug.json (debug).
# Use APP_ENV=debug to load config.debug.json.
# Use CONFIG_FILE=/path/to/config.json for an explicit path.
#
# Secrets referenced as ${VAR} in config.example.json are expanded from env
# vars at boot. Every var above the "Backups" section below is read somewhere
# in config.example.json — search that file for the exact ${VAR} name before
# adding/removing anything here, so this stays in sync with what actually gates
# a boot. The BACKUP_* / PGBACKREST_* / ARCHIVE_* / ANCHOR_S3_* vars at the
# bottom are different: docker-compose.yml, deploy/examples/
# docker-compose.backup.yml, the deploy/pgbackrest + deploy/ha/patroni scripts
# and scripts/backup/*.sh read them (the anchor pair through config.json's
# audit.anchor_store), not config.example.json.
#
# P-bootstrap-credential-scoping (D-204): in a split migrate/server/worker
# production deployment (docker-compose.yml), THIS file (with DB_PASSWORD)
# is the `migrate` binary's .env only. `server`/`worker` use the separate
# .env.runtime.example instead, which deliberately omits DB_PASSWORD.

# Required outside APP_ENV=debug — an unresolved ${VAR} anywhere is a boot
# error (D-038). JWT_SECRET and APIKEY_HASH_PEPPER are length-checked at boot
# (base-config's validate()/check_secret, min 32 bytes). APIKEY_HASH_PEPPER
# (P-api-key-hashing/D-112) is unconditional — every deployment authenticates
# api-key requests, so unlike S2S_KEY_ENCRYPTION_KEY/AUDIT_SIGNING_PRIVATE_KEY
# below there is no feature flag that skips this check. The DB_* and
# CACHE_PASSWORD connection credentials are NOT length-checked — but under
# app.deployment_profile = "production" every value below that is still one of
# these shipped placeholders is refused outright at boot (base-config's
# shipped-template denylist, BCF-3), so replace all of them with real secrets:
JWT_SECRET=change_me_use_openssl_rand_hex_64
APIKEY_HASH_PEPPER=change_me_use_openssl_rand_hex_64
DB_PASSWORD=change_me
DB_READONLY_PASSWORD=change_me

# Only read when docker-compose.replica.yml is layered on (P1.12's
# primary+replica recipe) — deploy/pg-primary-init.sh fails closed if this
# is unset in that case. Unused otherwise.
REPLICATION_PASSWORD=change_me

# Read at boot but only touched when a file/attachment is actually uploaded
# (base-storage's client is built lazily, no eager connectivity check) —
# still fill these in for any real deployment:
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key

# Optional — feature stays off (byte-for-byte today's behavior) until set:
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
SMTP_PASSWORD=
GOOGLE_AI_API_KEY=
S2S_KEY_ENCRYPTION_KEY=
AUDIT_SIGNING_PRIVATE_KEY=

# D-540 (audit plan item 2.7): required once app.deployment_profile is
# "production" — the audit key-encryption key (64 hex chars, openssl rand -hex 32,
# a dedicated key). Provision it BEFORE upgrading an existing production
# deployment, or boot refuses. Read by config.production*.example.json;
# config.example.json ships a public development key instead.
AUDIT_ERASURE_KEY_ENCRYPTION_KEY=

# Local-dev login reset (crates/server/src/dev_access_seed.rs). Leave EMPTY unless
# you want it. When set, every boot forces this account's password to this value,
# creating (and re-enabling) the account if needed — so resetting the dev database
# never locks you out. Unlike `server --bootstrap-admin <email>`, which mints a
# random password once and won't touch an account that already exists.
# Does NOT grant admin: run `server --bootstrap-admin <email>` once for that —
# it grants to an account that already exists rather than creating a second one.
#   minimum 12 characters, or boot fails
#
# Use a SYNTHETIC address, not your own login. The password is reapplied on every
# boot, so pointing this at a real account silently reverts any password you set
# through the UI the next time you restart — and puts that account's working
# password in plaintext on disk. A throwaway identity keeps both problems off any
# human account. Suggested:
#   ATTOME_DEV_LOGIN_EMAIL=dev-agent@attome.local
ATTOME_DEV_LOGIN_EMAIL=
ATTOME_DEV_LOGIN_PASSWORD=

# Local-dev automation/AI agent API key (crates/server/src/dev_access_seed.rs).
# Leave EMPTY unless you actually want one — empty is inert, and the seeding code
# does not exist at all in a release binary (#[cfg(debug_assertions)]) or outside
# APP_ENV=debug. When set, every boot upserts an API key so a database reset does
# not strand your scripts; edit the value and restart to rotate it.
#   generate with: openssl rand -hex 32   (minimum 32 characters, or boot fails)
#   then call the API with: Authorization: ApiKey <public key>:<this secret>
# The key acts as ATTOME_AGENT_API_USER_EMAIL's user, or the oldest active user
# when that is unset — i.e. usually your bootstrap admin, with all its rights.
ATTOME_AGENT_API_SECRET=
# Optional overrides; the public key defaults to "atk_pub_devagent".
ATTOME_AGENT_API_PUBLIC_KEY=
ATTOME_AGENT_API_USER_EMAIL=

# Logging
RUST_LOG=info,tower_http=debug

# ── Backups (pgBackRest → S3) ─────────────────────────────────────────────────
# Read by docker-compose.yml's `x-pgbackrest-repo-env` anchor (production-ha /
# Patroni, D-348), deploy/examples/docker-compose.backup.yml (single-primary),
# deploy/ha/patroni/entrypoint.sh + pgbackrest-leader-gate.sh,
# deploy/pgbackrest/*.sh and scripts/backup/restore-drill.sh — NOT by
# config.json. Provision the bucket + producer credential first
# (deploy/backup/README.md). Every value here is a soft default in compose;
# the fail-closed checks live in the entrypoints, which refuse to start with
# BACKUP_ENABLED=true and an incomplete repo.
#
# Default false ON PURPOSE: archive_mode=on against an unreachable repo makes
# Postgres retain WAL until the volume fills and writes stop. Unset = NO
# Postgres backup at all; set it deliberately once the bucket exists.
BACKUP_ENABLED=false
# https only — pgbackrest's S3 driver has no plain-HTTP mode.
BACKUP_S3_ENDPOINT=https://s3.example.internal
# Self-hosted RustFS/MinIO TLS is often not on 443; must be a real number,
# never empty (an empty PGBACKREST_REPO1_STORAGE_PORT is a pgbackrest error).
BACKUP_S3_PORT=443
BACKUP_S3_BUCKET=attome-backups
BACKUP_S3_REGION=us-east-1
# The PRODUCER identity: Put/Get/List only — no DeleteObject, no lifecycle,
# no bucket-config rights (deploy/backup/aws-iam-backup-policy.json).
BACKUP_S3_ACCESS_KEY=change_me
BACKUP_S3_SECRET_KEY=change_me
# `n` only for a self-signed cert in dev/test — skips VERIFYING TLS, never TLS
# itself (production-ha reads this; the single-primary recipe and the restore
# drill read PGBACKREST_REPO1_STORAGE_VERIFY_TLS directly instead).
BACKUP_S3_VERIFY_TLS=y
# Repo path inside the bucket. production-ha only; the single-primary recipe
# and scripts/backup/restore-drill.sh hardcode `/main` — see the drill notes
# in deploy/backup/README.md before drilling a production-ha backup.
BACKUP_REPO_PATH=/attome
# pgbackrest repo encryption passphrase (aes-256-cbc) — separate from every
# app secret; losing it makes every backup unreadable. Generate:
# openssl rand -hex 32
BACKUP_CIPHER_PASS=change_me_use_openssl_rand_hex_32
# Stanza name. production-ha defaults to `attome`; the single-primary recipe
# hardcodes `main`, and restore-drill.sh ALSO defaults to `main` — export the
# stanza the backup was actually taken under when you run the drill.
PGBACKREST_STANZA=attome
# cron expression for the nightly full backup (leader-gated on production-ha).
BACKUP_SCHEDULE=0 2 * * *
# Counts FULL BACKUPS retained, not days (the old BACKUP_RETENTION_FULL_DAYS
# name is a deprecated alias the single-primary recipe still accepts).
BACKUP_RETENTION_FULL_COUNT=14
# pgbackrest console log level on the Patroni nodes (production-ha only).
BACKUP_LOG_LEVEL_CONSOLE=info
# Postgres archive_timeout — the RPO ceiling: WAL is shipped at least this often.
ARCHIVE_TIMEOUT_SECS=60
# pgbackrest-monitor sidecar (production-ha): how often it re-reads
# `pgbackrest info` to refresh attome_backup_last_success_timestamp_seconds.
BACKUP_MONITOR_INTERVAL_SECS=300
# Where the node_exporter textfile (attome_backup.prom) is written INSIDE the
# backup/monitor container; the compose files mount a volume there.
BACKUP_METRICS_TEXTFILE_DIR=/var/lib/attome-backup-metrics
# Optional: also push the same metrics to a Prometheus Pushgateway.
BACKUP_METRICS_PUSHGATEWAY_URL=
# production-ha first boot: how long a node waits to become leader and run
# `stanza-create` before giving up, and the poll interval while waiting
# (deploy/ha/patroni/pgbackrest-leader-gate.sh).
PGBACKREST_BOOTSTRAP_TIMEOUT_SECS=900
PGBACKREST_BOOTSTRAP_POLL_SECS=10

# ── Restore drill (scripts/backup/restore-drill.sh) ───────────────────────────
# Per-invocation, exported in the shell that runs the drill by hand
# (nothing sets them from stored secrets; this repo has no CI) — listed here commented out
# so the full set is in one place. The drill also needs every BACKUP_S3_*,
# BACKUP_CIPHER_PASS and PGBACKREST_STANZA value above. It has NO
# DRILL_I_UNDERSTAND gate (that gate belongs to verify-patroni-backup.sh and
# the scripts/ha drills, which kill containers — this one only creates
# throwaway volumes/containers). Required, no default:
#DRILL_SERVER_IMAGE_DIGEST=sha256:...   # exact digest to prove recovery against (D-195); no floating-tag fallback
#DRILL_DB_PASSWORD=                     # the backed-up PRIMARY's real postgres password — a restore keeps it
# Optional (defaults shown):
#DRILL_SERVER_IMAGE_REF=ghcr.io/attome-ai/attome-server
#DRILL_PROD_DIGEST=                     # digest production runs; asserted equal to DRILL_SERVER_IMAGE_DIGEST when set
#DRILL_IMAGE=attome-pgbackrest-postgres-primary   # the pgbackrest-capable Postgres image used for the restore
#DRILL_NETWORK=attome-network
#DRILL_REDIS_HOST=attome-dragonfly-dev
#DRILL_REDIS_PORT=6379
#DRILL_REDIS_PASSWORD=
#DRILL_DB_SCHEMA=attome_dev
#DRILL_DB_READY_TIMEOUT_SECS=60
#DRILL_APP_READY_TIMEOUT_SECS=120
#DRILL_EVIDENCE_DIR=./drill-evidence
#DRILL_SIGNING_KEY=                     # dedicated ssh-ed25519 key for the evidence file; unsigned + WARN if unset
#DRILL_VERIFY_SQL=SELECT count(*) FROM xrm_core_systemuser;
#DRILL_APIKEY_HASH_PEPPER=drill-throwaway-apikey-pepper-do-not-use-anywhere-0   # the primary's real pepper when it has API-key history (D-120)
#DRILL_APIKEY_HASH_PEPPER_ID=0
#DRILL_APIKEY_HASH_WRITE_VERSIONED=false
# Signature verification of the restored image. INAPPLICABLE TODAY: no
# release pipeline signs an image any more, so there is nothing for cosign
# to verify. Leave both unset unless image signing is rebuilt; the values
# below are the shape a keyless/OIDC issuer would need, not a live config.
#DRILL_COSIGN_IDENTITY_REGEXP=
#DRILL_COSIGN_OIDC_ISSUER=

# ── Audit anchor bucket (D-352) ───────────────────────────────────────────────
# Read through config.json's audit.anchor_store.s3_access_key / s3_secret_key
# ${VAR} placeholders (deploy/audit-anchor/README.md) — only when
# audit.external_anchoring_enabled = true, in which case boot FAILS unless the
# Object-Lock bucket is provisioned. Same producer/operator split as the backup
# bucket; a different credential pair, never the BACKUP_S3_* one.
ANCHOR_S3_ACCESS_KEY=
ANCHOR_S3_SECRET_KEY=

# Encrypts AI provider API keys at rest (inference.provider_credential_key). 64 hex chars (32 bytes). Generate with: openssl rand -hex 32
AI_PROVIDER_CREDENTIAL_KEY=
