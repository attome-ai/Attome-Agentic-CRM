# P-bootstrap-credential-scoping (D-204) — pairs with
# config.production.runtime.example.json (the `server`/`worker` config
# variant), NOT config.example.json/.env.example (the dev template's
# smaller var set, since dev's database.migrator/.runtime are
# all off/null by default). Copy to .env.runtime; docker-compose.yml's
# `server`/`worker` services load it via `env_file: .env.runtime`.
#
# `AppConfig::from_file()` expands every ${VAR} in the WHOLE config file
# before parsing (D-038 fail-closed) — an unresolved placeholder anywhere is
# a boot error, regardless of whether that section is one this process
# actually touches. So this list is every ${VAR} referenced anywhere in
# config.production.runtime.example.json, minus exactly one:
#
# DB_PASSWORD is intentionally ABSENT and must stay that way — it is the
# schema-bootstrap/CREATE-ROLE-capable bootstrap credential, needed ONLY by
# the dedicated one-shot `migrate` binary (its own .env, from .env.example,
# pairs with config.production.example.json). Adding DB_PASSWORD here
# defeats the entire point of this file: keeping the bootstrap credential
# out of the long-lived server/worker containers' environment entirely.

# Required outside APP_ENV=debug — an unresolved ${VAR} anywhere is a boot
# error (D-038). JWT_SECRET and APIKEY_HASH_PEPPER are length-checked
# (base-config's validate()/check_secret, min 32 bytes); the DB_*_PASSWORD and
# CACHE_PASSWORD connection credentials are not — but under
# app.deployment_profile = "production" any value below that is still one of
# these shipped placeholders is refused at boot (base-config's
# shipped-template denylist, BCF-3). Replace all of them with real secrets:
JWT_SECRET=change_me_use_openssl_rand_hex_64
APIKEY_HASH_PEPPER=change_me_use_openssl_rand_hex_64
DB_READONLY_PASSWORD=change_me
# P-db-privilege-separation (D-117/D-148) — the DDL-capable and DML-only
# identities this process actually connects as. Same values an operator
# already set for the `migrate` binary's own .env (that's where
# `server::db_role_seed::seed_migrator`/`seed_runtime` apply these
# passwords to the real Postgres roles) — this file just needs the same
# secret to authenticate as them, never to seed them.
DB_MIGRATOR_PASSWORD=change_me
DB_RUNTIME_PASSWORD=change_me
CACHE_PASSWORD=change_me

S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key

# Required only once you set security.bootstrap_admin_email in your config
# (see the license-ops/security-model skills) — must match a user you've
# already registered via POST /api/v1/auth/register, or boot fails loudly:
BOOTSTRAP_ADMIN_EMAIL=

# Optional — feature stays off (byte-for-byte today's behavior) until set:
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
SMTP_PASSWORD=
GOOGLE_AI_API_KEY=
S2S_KEY_ENCRYPTION_KEY=
AUDIT_SIGNING_PRIVATE_KEY=

# D-540 (audit plan item 2.7): required once app.deployment_profile is
# "production" — the audit key-encryption key (64 hex chars, openssl rand -hex 32,
# a dedicated key). Provision it BEFORE upgrading an existing production
# deployment, or boot refuses. Read by config.production*.example.json;
# config.example.json ships a public development key instead.
AUDIT_ERASURE_KEY_ENCRYPTION_KEY=

# Logging
RUST_LOG=info,tower_http=debug
