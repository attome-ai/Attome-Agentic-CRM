<?xml version="1.0" encoding="UTF-8"?>
<!-- C7-T1: the Outlook add-in. `node build.mjs --url <deployment>` writes
     dist/manifest.xml with {{BASE}} replaced by the address the task pane is
     served from (the deployment's /addins/outlook/). -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>6c1f5d0a-7a3e-4c55-9b0e-8f2d4a1e9c31</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Attome</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Attome">
    <Override Locale="ar-SA" Value="أتوم" />
  </DisplayName>
  <Description DefaultValue="See the sender's records in Attome, log emails, create leads and cases, and insert reply templates.">
    <Override Locale="ar-SA" Value="اعرض سجلات المرسل في أتوم، وسجّل الرسائل، وأنشئ العملاء المحتملين والحالات، وأدرج قوالب الرد." />
  </Description>
  <IconUrl DefaultValue="{{BASE}}icon.png" />
  <HighResolutionIconUrl DefaultValue="{{BASE}}icon.png" />
  <SupportUrl DefaultValue="{{BASE}}" />
  <AppDomains>
    <AppDomain>{{ORIGIN}}</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="{{BASE}}taskpane.html" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="{{BASE}}taskpane.html" />
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="ReadOrEdit" />
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
</OfficeApp>
