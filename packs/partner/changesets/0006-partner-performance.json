          "name": "partner_mdf_return",
          "required_privilege": "partner_performance_snapshot.read",
          "sql": "SELECT partner_account_ref, as_of, mdf_spent, mdf_attributed_revenue FROM partner_performance_snapshot WHERE is_active = true ORDER BY partner_account_ref, as_of DESC",
