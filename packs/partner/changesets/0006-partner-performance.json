    {
      "args": {
        "definition": {
          "entity": "opportunity",
          "entity_mappings": [],
          "is_customized": false,
          "is_report": false,
          "name": "partner_pipeline",
          "required_privilege": "partner_performance_snapshot.read",
          "sql": "SELECT partner_account_ref, sum(amount) AS pipeline FROM opportunity WHERE partner_account_ref IS NOT NULL AND stage NOT IN ('closed_won', 'closed_lost') AND is_active = true GROUP BY partner_account_ref",
          "table_definition": null
        }
      },
      "op": "upsert_query",
      "phase": "expand",
      "seq": 25,
      "target": {
        "entity": "opportunity",
        "query": "partner_pipeline"
      }
    },
    {
      "args": {
        "definition": {
          "entity": "opportunity",
          "entity_mappings": [],
          "is_customized": false,
          "is_report": false,
          "name": "partner_won_revenue",
          "required_privilege": "partner_performance_snapshot.read",
          "sql": "SELECT partner_account_ref, sum(amount) AS won_revenue FROM opportunity WHERE partner_account_ref IS NOT NULL AND stage = 'closed_won' AND is_active = true GROUP BY partner_account_ref",
          "table_definition": null
        }
      },
      "op": "upsert_query",
      "phase": "expand",
      "seq": 26,
      "target": {
        "entity": "opportunity",
        "query": "partner_won_revenue"
      }
    },
    {
      "args": {
        "definition": {
          "entity": "opportunity",
          "entity_mappings": [],
          "is_customized": false,
          "is_report": false,
          "name": "partner_win_rate",
          "required_privilege": "partner_performance_snapshot.read",
          "sql": "SELECT partner_account_ref, 100.0 * count(*) FILTER (WHERE stage = 'closed_won') / NULLIF(count(*), 0) AS win_rate FROM opportunity WHERE partner_account_ref IS NOT NULL AND stage IN ('closed_won', 'closed_lost') AND is_active = true GROUP BY partner_account_ref",
          "table_definition": null
        }
      },
      "op": "upsert_query",
      "phase": "expand",
      "seq": 27,
      "target": {
        "entity": "opportunity",
        "query": "partner_win_rate"
      }
    },
    {
      "args": {
        "definition": {
          "entity": "lead",
          "entity_mappings": [],
          "is_customized": false,
          "is_report": false,
          "name": "partner_lead_accept_hours",
          "required_privilege": "partner_performance_snapshot.read",
          "sql": "SELECT partner_account_ref, avg(extract(epoch FROM partner_responded_at - partner_offered_at) / 3600) AS accept_hours FROM lead WHERE partner_status = 'accepted' AND partner_responded_at IS NOT NULL GROUP BY partner_account_ref",
          "table_definition": null
        }
      },
      "op": "upsert_query",
      "phase": "expand",
      "seq": 28,
      "target": {
        "entity": "lead",
        "query": "partner_lead_accept_hours"
      }
    },
    {
      "args": {
        "definition": {
          "entity": "partner_certification",
          "entity_mappings": [],
          "is_customized": false,
          "is_report": false,
          "name": "partner_certifications",
          "required_privilege": "partner_performance_snapshot.read",
          "sql": "SELECT partner_account_ref, count(DISTINCT partner_contact_ref) AS certified_people FROM partner_certification WHERE (expires_on IS NULL OR expires_on > CURRENT_DATE) AND is_active = true GROUP BY partner_account_ref",
          "table_definition": null
        }
      },
      "op": "upsert_query",
      "phase": "expand",
      "seq": 29,
      "target": {
        "entity": "partner_certification",
        "query": "partner_certifications"
      }
    },
    {
      "args": {
