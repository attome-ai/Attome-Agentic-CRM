    {
      "args": {
        "key_fields": [
          "name"
        ],
        "values": {
          "body": "<h1>Packing slip &middot; <span dir=\"rtl\" lang=\"ar\">قائمة التعبئة</span></h1><p class=\"sub\">{{ delivery_group }} &middot; {{ promised_date | date }}</p><table><thead><tr><th class=\"en\" dir=\"ltr\">Product</th><th class=\"en\" dir=\"ltr\">Quantity</th><th class=\"ar\" dir=\"rtl\" lang=\"ar\">الكمية</th><th class=\"ar\" dir=\"rtl\" lang=\"ar\">المنتج</th></tr></thead><tbody>{% for l in fulfilment_order_line limit 200 %}<tr><td class=\"en\" dir=\"ltr\">{{ l.product_ref }}</td><td class=\"en\" dir=\"ltr\">{{ l.quantity | number }}</td><td class=\"ar\" dir=\"rtl\">{{ l.quantity | number }}</td><td class=\"ar\" dir=\"rtl\">{{ l.product_ref }}</td></tr>{% end %}</tbody></table>",
          "entity": "fulfilment_order",
          "format": "pdf",
          "name": "Packing slip",
          "page_size": "A4",
          "pdf_profile": "standard",
          "stylesheet": "body{font-family:sans-serif;font-size:11pt}h1{margin-block-end:0}.sub{color:#555;margin-block-start:.25rem}table{inline-size:100%;border-collapse:collapse}th,td{padding:4px 6px;border-block-end:1px solid #ccc}th.ar,td.ar{text-align:right}th.en,td.en{text-align:left}"
        }
      },
