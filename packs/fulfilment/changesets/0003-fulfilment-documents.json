    {
      "args": {
        "key_fields": [
          "name"
        ],
        "values": {
          "body": "<h1>Delivery note &middot; <span dir=\"rtl\" lang=\"ar\">مذكرة التسليم</span></h1><p class=\"sub\">{{ delivery_group }} &middot; {{ promised_date | date }}</p><table><thead><tr><th class=\"en\" dir=\"ltr\">Product</th><th class=\"en\" dir=\"ltr\">Quantity</th><th class=\"en\" dir=\"ltr\">Received &middot; <span lang=\"ar\">استُلم</span></th><th class=\"ar\" dir=\"rtl\" lang=\"ar\">الكمية</th><th class=\"ar\" dir=\"rtl\" lang=\"ar\">المنتج</th></tr></thead><tbody>{% for l in fulfilment_order_line limit 200 %}<tr><td class=\"en\" dir=\"ltr\">{{ l.product_ref }}</td><td class=\"en\" dir=\"ltr\">{{ l.quantity | number }}</td><td class=\"en\" dir=\"ltr\">&#9744;</td><td class=\"ar\" dir=\"rtl\">{{ l.quantity | number }}</td><td class=\"ar\" dir=\"rtl\">{{ l.product_ref }}</td></tr>{% end %}</tbody></table>",
          "entity": "fulfilment_order",
