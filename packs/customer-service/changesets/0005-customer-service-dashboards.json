  "operations": [
    {
      "args": {
        "definition": {
          "entity": null,
          "entity_mappings": [],
          "is_customized": true,
          "is_report": true,
          "name": "CS: First Contact Resolution",
          "required_privilege": "service_ticket.read",
          "sql": "SELECT ROUND(100.0 * COUNT(*) FILTER (WHERE x.agent_replies <= 1) / NULLIF(COUNT(*), 0), 1) AS fcr_percent, COUNT(*)::bigint AS resolved_tickets FROM (SELECT t.id, COUNT(m.id) FILTER (WHERE m.author_kind = 'agent') AS agent_replies FROM service_ticket t LEFT JOIN case_message m ON m.case_ref = t.id AND (m.is_active IS NULL OR m.is_active = true) WHERE (t.is_active IS NULL OR t.is_active = true) AND t.status IN ('resolved', 'closed') AND t.resolved_at >= NOW() - INTERVAL '90 days' GROUP BY t.id) x",
          "table_definition": "[]"
        }
      },
      "op": "upsert_query",
      "phase": "expand",
      "seq": 1,
      "target": {
        "entity": "multi_entity_stored_query_with_no_primary_entity_bound",
        "query": "CS: First Contact Resolution"
      }
    },
    {
      "args": {
        "definition": {
          "entity": null,
          "entity_mappings": [],
          "is_customized": true,
          "is_report": true,
          "name": "CS: Backlog Age",
          "required_privilege": "service_ticket.read",
          "sql": "SELECT CASE WHEN age < INTERVAL '1 day' THEN '< 1 day' WHEN age < INTERVAL '3 days' THEN '1-3 days' WHEN age < INTERVAL '7 days' THEN '3-7 days' WHEN age < INTERVAL '30 days' THEN '7-30 days' ELSE '30+ days' END AS age_band, COUNT(*)::bigint AS open_tickets FROM (SELECT NOW() - t.created_at AS age FROM service_ticket t WHERE (t.is_active IS NULL OR t.is_active = true) AND t.status NOT IN ('resolved', 'closed')) x GROUP BY 1 ORDER BY MIN(age)",
          "table_definition": "[]"
        }
      },
      "op": "upsert_query",
      "phase": "expand",
      "seq": 2,
      "target": {
        "entity": "multi_entity_stored_query_with_no_primary_entity_bound",
        "query": "CS: Backlog Age"
      }
    },
    {
      "args": {
        "definition": {
          "entity": null,
          "entity_mappings": [],
          "is_customized": true,
          "is_report": true,
          "name": "CS: Handle Time by Agent",
          "required_privilege": "service_ticket.read",
          "sql": "SELECT t.assignee_id, ROUND(AVG(EXTRACT(EPOCH FROM (t.resolved_at - COALESCE(t.claimed_at, t.created_at))) / 3600)::numeric, 1) AS avg_handle_hours, COUNT(*)::bigint AS resolved_tickets FROM service_ticket t WHERE (t.is_active IS NULL OR t.is_active = true) AND t.resolved_at IS NOT NULL AND t.assignee_id IS NOT NULL AND t.resolved_at >= NOW() - INTERVAL '90 days' GROUP BY t.assignee_id ORDER BY avg_handle_hours",
          "table_definition": "[]"
        }
      },
      "op": "upsert_query",
      "phase": "expand",
      "seq": 3,
      "target": {
        "entity": "multi_entity_stored_query_with_no_primary_entity_bound",
        "query": "CS: Handle Time by Agent"
      }
    },
    {
      "args": {
        "definition": {
          "entity": null,
          "entity_mappings": [],
          "is_customized": true,
          "is_report": true,
          "name": "CS: SLA Attainment by Customer",
          "required_privilege": "service_ticket.read",
          "sql": "SELECT c.name AS customer, ROUND(100.0 * COUNT(*) FILTER (WHERE t.sla_breached IS NOT TRUE) / NULLIF(COUNT(*), 0), 1) AS sla_attainment_percent, COUNT(*)::bigint AS tickets, COUNT(*) FILTER (WHERE t.sla_breached IS TRUE)::bigint AS breached FROM service_ticket t JOIN customer c ON c.id = t.customer_ref WHERE (t.is_active IS NULL OR t.is_active = true) AND t.created_at >= NOW() - INTERVAL '90 days' GROUP BY c.id, c.name ORDER BY sla_attainment_percent, tickets DESC",
          "table_definition": "[]"
        }
      },
      "op": "upsert_query",
      "phase": "expand",
      "seq": 4,
      "target": {
        "entity": "multi_entity_stored_query_with_no_primary_entity_bound",
        "query": "CS: SLA Attainment by Customer"
      }
    },
