          "is_customized": true,
          "is_report": true,
          "name": "Deals: At Risk",
          "required_privilege": "opportunity.read",
          "sql": "SELECT o.id, o.name, o.stage, o.amount, o.close_date, o.risk_score, o.risk_reasons FROM opportunity o WHERE o.is_active IS NOT FALSE AND o.risk_score >= 50 AND o.stage NOT IN ('closed_won', 'closed_lost') ORDER BY o.risk_score DESC, o.amount DESC NULLS LAST",
