    {
      "args": {
        "definition": {
          "entity": null,
          "entity_mappings": [],
          "is_customized": true,
          "is_report": true,
          "name": "Sales: Pipeline by Product",
          "required_privilege": "opportunity.read",
          "sql": "SELECT l.product_ref, COUNT(DISTINCT o.id) AS opportunities, SUM(l.line_total) AS pipeline FROM opportunity o JOIN opportunity_line l ON l.opportunity_ref = o.id WHERE (o.is_active IS NULL OR o.is_active = true) AND (l.is_active IS NULL OR l.is_active = true) AND o.stage NOT IN ('closed_won', 'closed_lost') GROUP BY l.product_ref ORDER BY pipeline DESC",
          "table_definition": "[]"
        }
      },
      "op": "upsert_query",
      "phase": "expand",
      "seq": 7,
      "target": {
        "entity": "multi_entity_stored_query_with_no_primary_entity_bound",
        "query": "Sales: Pipeline by Product"
      }
    },
    {
      "args": {
        "definition": {
          "entity": null,
          "entity_mappings": [],
          "is_customized": true,
          "is_report": true,
          "name": "Sales: Won by Product Family",
          "required_privilege": "opportunity.read",
          "sql": "SELECT p.family_ref, COUNT(DISTINCT o.id) AS opportunities, SUM(l.line_total) AS won FROM opportunity o JOIN opportunity_line l ON l.opportunity_ref = o.id JOIN product p ON p.id = l.product_ref WHERE (o.is_active IS NULL OR o.is_active = true) AND (l.is_active IS NULL OR l.is_active = true) AND o.stage = 'closed_won' GROUP BY p.family_ref ORDER BY won DESC",
          "table_definition": "[]"
        }
      },
      "op": "upsert_query",
      "phase": "expand",
      "seq": 8,
      "target": {
        "entity": "multi_entity_stored_query_with_no_primary_entity_bound",
        "query": "Sales: Won by Product Family"
      }
    },
