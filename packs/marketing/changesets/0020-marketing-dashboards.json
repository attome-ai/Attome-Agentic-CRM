    {
      "args": {
        "definition": {
          "entity": null,
          "entity_mappings": [],
          "is_customized": true,
          "is_report": true,
          "name": "Marketing: Campaign Performance",
          "required_privilege": "campaign.read",
          "sql": "SELECT c.name AS campaign, COUNT(m.id) FILTER (WHERE m.status IN ('responded', 'attended', 'converted'))::bigint AS responses, COUNT(m.id)::bigint AS members, COUNT(m.id) FILTER (WHERE m.status = 'converted')::bigint AS converted FROM campaign c LEFT JOIN campaign_member m ON m.campaign_ref = c.id AND (m.is_active IS NULL OR m.is_active = true) WHERE (c.is_active IS NULL OR c.is_active = true) AND c.status IN ('active', 'completed') GROUP BY c.id, c.name ORDER BY responses DESC LIMIT 50",
          "table_definition": "[]"
        }
      },
      "op": "upsert_query",
      "phase": "expand",
      "seq": 1,
      "target": {
        "entity": "multi_entity_stored_query_with_no_primary_entity_bound",
        "query": "Marketing: Campaign Performance"
      }
    },
    {
      "args": {
        "definition": {
          "entity": null,
          "entity_mappings": [],
          "is_customized": true,
          "is_report": true,
          "name": "Marketing: Email Engagement by Send",
          "required_privilege": "campaign.read",
          "sql": "SELECT s.subject, COUNT(*) FILTER (WHERE r.status = 'sent')::bigint AS sent, COUNT(r.opened_at)::bigint AS opened, COUNT(r.clicked_at)::bigint AS clicked, ROUND(100.0 * COUNT(r.opened_at) / NULLIF(COUNT(*) FILTER (WHERE r.status = 'sent'), 0), 1) AS open_rate_percent, ROUND(100.0 * COUNT(r.clicked_at) / NULLIF(COUNT(*) FILTER (WHERE r.status = 'sent'), 0), 1) AS click_rate_percent, to_char(s.created_at, 'YYYY-MM-DD') AS sent_on FROM email_campaign_send s JOIN email_campaign_recipient r ON r.send_id = s.id WHERE s.created_at >= NOW() - INTERVAL '90 days' GROUP BY s.id, s.subject, s.created_at ORDER BY s.created_at DESC LIMIT 30",
          "table_definition": "[]"
        }
      },
      "op": "upsert_query",
      "phase": "expand",
      "seq": 2,
      "target": {
        "entity": "multi_entity_stored_query_with_no_primary_entity_bound",
        "query": "Marketing: Email Engagement by Send"
      }
    },
    {
      "args": {
        "definition": {
          "entity": null,
          "entity_mappings": [],
          "is_customized": true,
          "is_report": true,
          "name": "Marketing: Leads by First Touch Source",
          "required_privilege": "lead.read",
          "sql": "SELECT COALESCE(NULLIF(t.first_touch_source, ''), '(direct)') AS source, COUNT(*)::bigint AS leads, COUNT(*) FILTER (WHERE t.lifecycle_stage IN ('sales_qualified', 'customer') OR t.lead_status = 'converted')::bigint AS qualified FROM \"lead\" t WHERE (t.is_active IS NULL OR t.is_active = true) AND t.created_at >= NOW() - INTERVAL '180 days' GROUP BY 1 ORDER BY leads DESC LIMIT 25",
          "table_definition": "[]"
        }
      },
      "op": "upsert_query",
      "phase": "expand",
      "seq": 3,
      "target": {
        "entity": "multi_entity_stored_query_with_no_primary_entity_bound",
        "query": "Marketing: Leads by First Touch Source"
      }
    },
    {
      "args": {
        "definition": {
          "entity": null,
          "entity_mappings": [],
          "is_customized": true,
          "is_report": true,
          "name": "Marketing: Campaign ROI",
          "required_privilege": "campaign.read",
          "sql": "SELECT c.name AS campaign, ROUND(100.0 * (COALESCE(w.won, 0) - c.budget) / NULLIF(c.budget, 0), 1) AS roi_percent, c.budget, COALESCE(w.won, 0) AS won_revenue FROM campaign c LEFT JOIN (SELECT x.campaign_ref, SUM(x.amount) AS won FROM (SELECT DISTINCT l.campaign_ref, o.id, o.amount FROM \"lead\" l JOIN opportunity o ON o.account_ref = l.converted_account_ref AND o.stage = 'closed_won' AND (o.is_active IS NULL OR o.is_active = true) WHERE (l.is_active IS NULL OR l.is_active = true) AND l.campaign_ref IS NOT NULL) x GROUP BY x.campaign_ref) w ON w.campaign_ref = c.id WHERE (c.is_active IS NULL OR c.is_active = true) AND c.budget > 0 ORDER BY roi_percent DESC NULLS LAST LIMIT 50",
          "table_definition": "[]"
        }
      },
      "op": "upsert_query",
      "phase": "expand",
      "seq": 4,
      "target": {
        "entity": "multi_entity_stored_query_with_no_primary_entity_bound",
        "query": "Marketing: Campaign ROI"
      }
    },
