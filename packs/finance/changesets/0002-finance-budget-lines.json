    {
      "args": {
        "definition": {
          "entity": null,
          "entity_mappings": [],
          "is_customized": true,
          "is_report": true,
          "name": "Finance: Budget vs Actual",
          "required_privilege": "budget.read",
          "sql": "SELECT b.id, b.name, b.period_start, b.period_end, b.budget_amount, COALESCE(SUM(e.amount) FILTER (WHERE e.status IN ('approved', 'paid')), 0) AS actual, b.budget_amount - COALESCE(SUM(e.amount) FILTER (WHERE e.status IN ('approved', 'paid')), 0) AS remaining FROM budget b LEFT JOIN expense e ON e.budget_ref = b.id AND (e.is_active IS NULL OR e.is_active = true) WHERE (b.is_active IS NULL OR b.is_active = true) GROUP BY b.id, b.name, b.period_start, b.period_end, b.budget_amount ORDER BY b.name",
          "table_definition": "[]"
        }
      },
      "op": "upsert_query",
      "phase": "expand",
      "seq": 27,
      "target": {
        "entity": "multi_entity_stored_query_with_no_primary_entity_bound",
        "query": "Finance: Budget vs Actual"
      }
